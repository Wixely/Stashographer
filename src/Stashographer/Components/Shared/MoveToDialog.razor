@* Shared location-aware destination picker used by inventory and Places quick moves. *@

<MudDialog>
    <DialogContent>
        @if (RoomsOnly)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Move @ThingLabel to which room?</MudText>
            <MudList T="Location" Dense="true">
                @foreach (var room in Locations)
                {
                    <MudListItem T="Location" Icon="@Icons.Material.Filled.Room" OnClick="@(() => PickRoom(room))">
                        @room.Name
                        <MudChip T="string" Size="Size.Small" Class="ml-1">@room.Containers.Count containers</MudChip>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-3">Move @ThingLabel</MudText>
            <PlacementPicker Locations="Locations"
                             @bind-LocationId="_locationId"
                             @bind-ContainerId="_containerId"
                             DisabledContainerIds="DisabledContainerIds" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        @if (!RoomsOnly)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Choose"
                       Disabled="@(_locationId is null && _containerId is null)">Move</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The chosen destination: a room (ContainerId null = loose) or a container in it.</summary>
    public record Destination(int LocationId, int? ContainerId);

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public string ThingLabel { get; set; } = "items";

    /// <summary>Containers that are not valid targets (e.g. the container being moved itself).</summary>
    [Parameter] public HashSet<int> DisabledContainerIds { get; set; } = new();

    /// <summary>When true, only rooms can be picked (moving containers, not items).</summary>
    [Parameter] public bool RoomsOnly { get; set; }

    private int? _locationId;
    private int? _containerId;

    private void PickRoom(Location room)
    {
        if (RoomsOnly)
        {
            Dialog.Close(DialogResult.Ok(new Destination(room.Id, null)));
        }
    }

    private void Choose()
    {
        var locationId = _locationId
            ?? Locations.SelectMany(location => location.Containers)
                .First(container => container.Id == _containerId).LocationId;
        Dialog.Close(DialogResult.Ok(new Destination(locationId, _containerId)));
    }
}
