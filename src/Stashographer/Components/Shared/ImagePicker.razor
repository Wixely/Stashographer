@* Compact photo control: tap the tile to pick a photo (mobile browsers normally offer
   both the camera and photo library), or add one from a URL. Uploads immediately and
   reports the stored image id. Dedicated camera capture lives on the Scan page. *@
@inject ImageService Images
@inject ISnackbar Snackbar

<div class="image-picker" style="@($"width:{Width};")">
    <label class="image-picker-tile" style="@($"height:{Height};")">
        @if (ImageUrls.Has(ImageId, FallbackUrl))
        {
            <img src="@ImageUrls.For(ImageId, FallbackUrl, PreviewWidth)" alt="@Label" />
            <div class="image-picker-overlay">
                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" />
                <span>Change</span>
            </div>
        }
        else
        {
            <div class="image-picker-empty">
                <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Size="Size.Large" />
                <span>@Label</span>
            </div>
        }
        @* Do not set capture here: several mobile browsers interpret it as "camera only",
           which makes an existing photo impossible to choose. The Scan page exposes a
           separate, explicit camera input when direct capture is wanted. *@
        <ResilientImageInput Id="@_inputId" OwnerKey="@EffectiveUploadKey"
                             Kind="BrowserUploadKind.Image"
                             UploadStarted="OnUploadStarted"
                             UploadCompleted="OnUploadCompleted"
                             UploadFailed="OnUploadFailed" />
    </label>

    <div class="d-flex gap-1 mt-1 justify-center">
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Link"
                   OnClick="@(() => _showUrl = !_showUrl)">URL</MudButton>
        @if (ImageUrls.Has(ImageId, FallbackUrl))
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete" OnClick="ClearAsync">Clear</MudButton>
        }
    </div>

    @if (_showUrl)
    {
        <div class="d-flex gap-1 align-center mt-1">
            <MudTextField @bind-Value="_url" Placeholder="https://…/photo.jpg" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" />
            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="FetchUrlAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_url))">Fetch</MudButton>
        </div>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-1" />
    }
</div>

@code {
    [Parameter] public int? ImageId { get; set; }
    [Parameter] public EventCallback<int?> ImageIdChanged { get; set; }

    /// <summary>Remote fallback shown when no image is stored yet (e.g. a lookup cover).
    /// Two-way bindable so Clear can wipe it along with the stored image.</summary>
    [Parameter] public string? FallbackUrl { get; set; }
    [Parameter] public EventCallback<string?> FallbackUrlChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Add photo";
    [Parameter] public string Width { get; set; } = "180px";
    [Parameter] public string Height { get; set; } = "160px";
    [Parameter] public int PreviewWidth { get; set; } = 360;
    [Parameter] public string? UploadKey { get; set; }

    private bool _busy;
    private bool _showUrl;
    private string _url = string.Empty;
    private readonly string _inputId = $"image-picker-{Guid.NewGuid():N}";
    private string EffectiveUploadKey => UploadKey ?? $"image-picker:{Label}";

    private Task OnUploadStarted(string _)
    {
        _busy = true;
        return Task.CompletedTask;
    }

    private async Task OnUploadCompleted(BrowserUploadResult upload)
    {
        try
        {
            if (upload.ImageId is not { } imageId)
                throw new InvalidOperationException("The uploaded image was not stored.");
            await SetImage(imageId);
        }
        finally { _busy = false; }
    }

    private Task OnUploadFailed(BrowserUploadFailure failure)
    {
        _busy = false;
        Snackbar.Add(failure.Message, failure.Retryable ? Severity.Warning : Severity.Error);
        return Task.CompletedTask;
    }

    private async Task FetchUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_url)) return;
        _busy = true;
        try
        {
            var image = await Images.SaveFromUrlAsync(_url.Trim());
            _url = string.Empty;
            _showUrl = false;
            await SetImage(image.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't fetch image: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    /// <summary>Removes whatever is showing: the stored image reference and the remote fallback.</summary>
    private async Task ClearAsync()
    {
        await SetImage(null);
        if (FallbackUrl is not null)
        {
            FallbackUrl = null;
            await FallbackUrlChanged.InvokeAsync(null);
        }
    }

    private async Task SetImage(int? id)
    {
        ImageId = id;
        await ImageIdChanged.InvokeAsync(id);
    }
}
