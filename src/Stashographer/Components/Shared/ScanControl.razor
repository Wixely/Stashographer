@* Camera barcode scanner + manual entry. Raises OnCode with whatever code is captured. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    @if (_scanning)
    {
        <video @ref="_video" playsinline muted style="width:100%;max-height:320px;border-radius:8px;background:#000"></video>
        <div class="d-flex justify-center mt-2">
            <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Stop"
                       OnClick="StopAsync">Stop camera</MudButton>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-center gap-2 py-4">
            <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Large" Color="Color.Primary" />
            <div class="d-flex gap-2 flex-wrap justify-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CameraAlt"
                           OnClick="StartAsync">Live scan</MudButton>
                <ResilientImageInput Id="barcode-photo-capture" OwnerKey="scan:barcode-photo"
                                     Kind="@(QueueBarcodePhotos
                                                ? BrowserUploadKind.QueuedBarcode
                                                : BrowserUploadKind.Barcode)"
                                     Capture="environment"
                                     UploadStarted="OnBarcodeUploadStarted"
                                     UploadCompleted="OnBarcodePhotoUploaded"
                                     UploadFailed="OnBarcodeUploadFailed" />
                <MudButton HtmlTag="label" for="barcode-photo-capture" Color="Color.Primary"
                           Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoCamera"
                           Disabled="_decodingPhoto">
                    @(_decodingPhoto ? "Reading…" : "Scan barcode photo")
                </MudButton>
            </div>
            @if (_cameraFailure is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    @_cameraFailure Use <b>Scan barcode photo</b> instead; it works without the live browser API.
                </MudAlert>
            }
        </div>
    }

    <MudDivider Class="my-3" />

    <MudText Typo="Typo.subtitle2" Class="mb-1">Enter a barcode / ISBN manually</MudText>
    <div class="d-flex gap-2 align-center">
        <MudTextField @ref="_manualField" @bind-Value="_manual" Placeholder="e.g. 9780262033848" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true" OnKeyDown="OnManualKey" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitManual"
                   Disabled="@string.IsNullOrWhiteSpace(_manual)">Look up</MudButton>
    </div>
</MudPaper>

@code {
    [Parameter] public EventCallback<string> OnCode { get; set; }
    [Parameter] public EventCallback<string> OnBarcodeQueued { get; set; }
    [Parameter] public bool QueueBarcodePhotos { get; set; }

    private ElementReference _video;
    private bool _scanning;
    private string? _cameraFailure;
    private bool _decodingPhoto;
    private string _manual = string.Empty;
    private MudTextField<string>? _manualField;
    private DotNetObjectReference<ScanControl>? _selfRef;

    private async Task StartAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _scanning = true;
        StateHasChanged();
        // Allow the <video> element to render before starting the camera.
        await Task.Yield();
        var result = await JS.InvokeAsync<ScanStartResult>("stashScanner.start", _video, _selfRef);
        if (!result.Ok)
        {
            _scanning = false;
            _cameraFailure = result.Reason switch
            {
                "insecure" => "Live camera scanning requires HTTPS when opened from another device.",
                "barcode-api" => "This browser does not provide its own live barcode detector.",
                "camera-api" => "This browser is not exposing live camera access on this page.",
                "NotAllowedError" => "Camera permission was denied.",
                "NotFoundError" => "The browser could not find a camera.",
                _ => "Live camera scanning could not start."
            };
            StateHasChanged();
        }
    }

    private async Task StopAsync()
    {
        await JS.InvokeVoidAsync("stashScanner.stop");
        _scanning = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCodeScanned(string code)
    {
        await StopAsync();
        await OnCode.InvokeAsync(code);
    }

    private async Task SubmitManual()
    {
        if (string.IsNullOrWhiteSpace(_manual)) return;
        var code = _manual.Trim();
        _manual = string.Empty;
        await OnCode.InvokeAsync(code);
        if (_manualField is not null) await _manualField.FocusAsync();
    }

    private async Task OnManualKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter") await SubmitManual();
    }

    private Task OnBarcodeUploadStarted(string _)
    {
        _decodingPhoto = true;
        return Task.CompletedTask;
    }

    private async Task OnBarcodePhotoUploaded(BrowserUploadResult upload)
    {
        _decodingPhoto = false;
        var code = upload.Code;
        if (code is null)
        {
            Snackbar.Add("No barcode was found. Move closer, avoid glare, and try again.", Severity.Warning);
            return;
        }

        if (upload.Kind == BrowserUploadKind.QueuedBarcode)
        {
            Snackbar.Add($"Queued barcode {code} — ready for the next scan.", Severity.Success);
            await OnBarcodeQueued.InvokeAsync(code);
        }
        else
        {
            Snackbar.Add($"Read barcode {code}.", Severity.Success);
            await OnCode.InvokeAsync(code);
        }
    }

    private Task OnBarcodeUploadFailed(BrowserUploadFailure failure)
    {
        _decodingPhoto = false;
        Snackbar.Add(failure.Message, failure.Retryable ? Severity.Warning : Severity.Error);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("stashScanner.stop"); } catch { /* circuit gone */ }
        _selfRef?.Dispose();
    }

    private record ScanStartResult(bool Ok, string? Reason);
}
