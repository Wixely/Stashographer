@implements IAsyncDisposable
@inject IntakeQueueService IntakeQueue
@inject ModifyQueueService ModifyQueue
@inject ILogger<NavMenu> Logger

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="inventory" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">Inventory</MudNavLink>
    <MudNavLink Href="expiry" Icon="@Icons.Material.Filled.EventBusy">Food Expiry</MudNavLink>
    <MudNavLink Href="consumption" Icon="@Icons.Material.Filled.History">Use History</MudNavLink>
    <MudNavLink Href="meal-plans" Icon="@Icons.Material.Filled.CalendarMonth">Meal Plans</MudNavLink>
    <MudNavLink Href="boms" Icon="@Icons.Material.Filled.RestaurantMenu">Recipes &amp; Builds</MudNavLink>
    <MudNavLink Href="scan" Icon="@Icons.Material.Filled.QrCodeScanner">Scan &amp; Add</MudNavLink>
    <MudNavLink Href="queues" Icon="@Icons.Material.Filled.Rule">
        <span>Queues</span>
        <span class="queue-count queue-count-intake"
              aria-label="@($"{_intakeQueueCount} items in intake queue")">@_intakeQueueCount</span>
        <span class="queue-count queue-count-modify"
              aria-label="@($"{_modifyQueueCount} items in modify queue")">@_modifyQueueCount</span>
    </MudNavLink>
    <MudNavLink Href="places" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Room">Places</MudNavLink>
    <MudNavLink Href="checkouts" Icon="@Icons.Material.Filled.AssignmentReturn">Checkouts</MudNavLink>
    <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
</MudNavMenu>

@code {
    private readonly CancellationTokenSource _dispose = new();
    private int _intakeQueueCount;
    private int _modifyQueueCount;

    protected override async Task OnInitializedAsync()
    {
        await RefreshQueueCountAsync();
        _ = RefreshQueueCountLoopAsync();
    }

    private async Task RefreshQueueCountAsync()
    {
        var counts = await IntakeQueue.GetCountsAsync(_dispose.Token);
        var modify = await ModifyQueue.GetCountsAsync(_dispose.Token);
        _intakeQueueCount = counts.Waiting + counts.Processing + counts.Ready + counts.Failed;
        _modifyQueueCount = modify.Open;
    }

    private async Task RefreshQueueCountLoopAsync()
    {
        var ct = _dispose.Token;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshQueueCountAsync();
                        StateHasChanged();
                    });
                }
                catch (Exception ex) when (!ct.IsCancellationRequested)
                {
                    Logger.LogWarning(ex, "Could not refresh queue navigation counts");
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Normal component disposal.
        }
    }

    public ValueTask DisposeAsync()
    {
        _dispose.Cancel();
        _dispose.Dispose();
        return ValueTask.CompletedTask;
    }
}
