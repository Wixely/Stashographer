@page "/scan"
@implements IAsyncDisposable
@inject ILookupRouter Lookup
@inject IAiEnrichmentService Ai
@inject PhotoIntakeService Intake
@inject InventoryService Inventory
@inject ImageService Images
@inject ItemDraftState Draft
@inject IntakeQueueService Queue
@inject SettingsService SettingsSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Scan &amp; add · Stashographer</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Scan &amp; add</MudText>
    @if (_intakeOptions.QueueEnabled)
    {
        <MudButton Href="queue" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlaylistAddCheck">
            Queue (@_queuedCount)
        </MudButton>
    }
</div>

@if (_intakeOptions.QueueEnabled)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        Queue mode is on. Each capture is saved immediately so you can continue with the next item.
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="6">
        <ScanControl OnCode="OnCode" />

        <MudPaper Class="pa-4 mt-3" Outlined="true">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle2">Add from a photo</MudText>
                @if (Ai.IsEnabled)
                {
                    <MudSwitch T="bool" @bind-Value="_multiMode" Label="Split into individual items"
                               Color="Color.Primary" Size="Size.Small" />
                }
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                @(Ai.IsEnabled
                    ? _multiMode
                        ? "One photo can contain several things. Each object is detected, given its own focused crop, and queued separately."
                        : "Snap or upload one item — AI focus-crops it, then matches it against your inventory or creates it."
                    : "The photo is attached to a new item for you to fill in. Enable AI in Settings to identify and count items automatically.")
            </MudText>

            <InputFile id="scan-photo-camera" OnChange="OnIntakePhotoChange" hidden accept="image/*" capture="environment" />
            <InputFile id="scan-photo-upload" OnChange="OnIntakePhotoChange" hidden accept="image/*" />
            <InputFile id="scan-receipt-upload" OnChange="OnReceiptPhotoChange" hidden accept="image/*" capture="environment" />
            <InputFile @key="_clipboardInputKey" id="scan-photo-clipboard"
                       OnChange="OnClipboardPhotoChange" hidden accept="image/*" />
            <div class="d-flex gap-2 flex-wrap">
                <MudButton HtmlTag="label" for="scan-photo-camera" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PhotoCamera" Disabled="_busy">Take photo</MudButton>
                <MudButton HtmlTag="label" for="scan-photo-upload" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload" Disabled="_busy">Upload image</MudButton>
                <MudButton HtmlTag="label" for="scan-receipt-upload" Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ReceiptLong" Disabled="_busy">Add receipt</MudButton>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                You can also paste an image from the clipboard anywhere on this page (Ctrl+V).
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        @if (_busy)
        {
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" /> @_busyText
            </div>
        }
        else if (_multiResults is not null)
        {
            <IntakeReviewBoard Results="_multiResults" OnDone="ClearIntake" />
        }
        else if (_pendingIntake is not null)
        {
            @* Ambiguous match → candidate picker · no match → pre-filled create card *@
            <MudPaper Class="pa-4" Outlined="true">
                <div class="d-flex gap-3 mb-2">
                    <MudImage Src="@ImageUrls.For(_pendingIntake.ImageId, null, 240)" Width="84" Height="84"
                              ObjectFit="ObjectFit.Cover" Class="rounded" />
                    <div>
                        <MudText Typo="Typo.h6">@(_pendingIntake.Identification?.Name ?? "Unidentified")</MudText>
                        @if (!string.IsNullOrWhiteSpace(_pendingIntake.Identification?.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_pendingIntake.Identification!.Description</MudText>
                        }
                    </div>
                </div>

                @if (_pendingIntake.Proposal.Action == IntakeAction.ChooseCandidate)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Is it one of these?</MudText>
                    <MudList T="Item" Dense="true">
                        @foreach (var cand in _pendingIntake.Candidates)
                        {
                            <MudListItem T="Item" OnClick="@(() => ApplyIncrementAsync(cand))">
                                <div class="d-flex align-center gap-2">
                                    @{ var candImg = ImageUrls.For(cand.ImageId, cand.ThumbnailUrl, 80); }
                                    @if (candImg is not null)
                                    {
                                        <MudAvatar Size="Size.Small"><MudImage Src="@candImg" /></MudAvatar>
                                    }
                                    <span>@cand.Name</span>
                                    <MudChip T="string" Size="Size.Small">@cand.Quantity.ToString("0.##") @cand.Unit</MudChip>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@PlacementLabel(cand)</MudText>
                                    @if (cand.Id == _pendingIntake.Proposal.MatchedItemId)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">likely</MudChip>
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="ApplyCreateAsync">None of these — create new</MudButton>
                    </div>
                }
                else
                {
                    @if (_pendingIntake.Proposal.Action == IntakeAction.CreateStockLot)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            The visible expiry differs from @_pendingIntake.Proposal.MatchedItemName.
                            This will create a linked stock lot instead of changing the existing lot's date.
                        </MudAlert>
                    }
                    @if (SpecialAttributeCatalog.GetPrice(_pendingIntake.Proposal.Draft) is { } price)
                    {
                        <MudText Typo="Typo.body2"><b>Unit price:</b> @SpecialAttributeCatalog.FormatPrice(price)</MudText>
                    }
                    @if (SpecialAttributeCatalog.GetExpiry(_pendingIntake.Proposal.Draft) is { } expiry)
                    {
                        <MudText Typo="Typo.body2">
                            <b>@ExpiryLabel(expiry):</b> @expiry.DateValue?.ToString("d MMM yyyy")
                        </MudText>
                    }
                    @foreach (var kv in _pendingIntake.Proposal.Draft.Attributes)
                    {
                        <MudText Typo="Typo.body2"><b>@kv.Key:</b> @kv.Value</MudText>
                    }
                    <div class="d-flex gap-2 mt-3">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(_pendingIntake.Proposal.Action == IntakeAction.CreateStockLot
                                                 ? ApplyLotAsync
                                                 : ApplyCreateAsync)">
                            @(_pendingIntake.Proposal.Action == IntakeAction.CreateStockLot
                                ? "Add as separate expiry lot"
                                : "Add to inventory")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="EditIntakeDraft">Edit first</MudButton>
                    </div>
                }
            </MudPaper>
        }
        else if (_lastApplied is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-2">
                @(_lastApplied.Action switch
                {
                    IntakeAction.IncrementExisting => $"+{_lastApplied.By:0.##} {_lastApplied.ItemName}",
                    IntakeAction.CreateStockLot => $"Added {_lastApplied.By:0.##} {_lastApplied.ItemName} as a separate expiry lot",
                    _ => $"Added \"{_lastApplied.ItemName}\""
                })
                — <MudLink Href="@($"items/{_lastApplied.ItemId}")">view</MudLink>
            </MudAlert>
        }
        else if (_result is not null)
        {
            <MudPaper Class="pa-4" Outlined="true">
                @if (_result.Found)
                {
                    <div class="d-flex gap-3">
                        @if (!string.IsNullOrEmpty(_result.ThumbnailUrl))
                        {
                            <MudImage Src="@_result.ThumbnailUrl" Width="72" Height="72" ObjectFit="ObjectFit.Contain" />
                        }
                        <div>
                            <MudText Typo="Typo.h6">@_result.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_result.SuggestedKind</MudChip>
                            <MudText Typo="Typo.caption" Class="d-block mt-1">via @_result.Source</MudText>
                        </div>
                    </div>
                    @foreach (var kv in _result.Attributes)
                    {
                        <MudText Typo="Typo.body2"><b>@kv.Key:</b> @kv.Value</MudText>
                    }
                    <MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="EditDraft">Review &amp; save</MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        No match for <b>@_result.Code</b>. You can still add it manually.
                    </MudAlert>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => AddBlank(_result.Code))">Add manually</MudButton>
                }
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                Scan a barcode, enter one manually, or add a photo to get items in.
            </MudAlert>
        }
    </MudItem>
</MudGrid>

@code {
    private LookupResult? _result;
    private bool _busy;
    private string _busyText = "Working…";
    private bool _multiMode = true;
    private IntakeResult? _pendingIntake;
    private List<IntakeResult>? _multiResults;
    private IntakeApplied? _lastApplied;
    private IntakeOptions _intakeOptions = new();
    private int _queuedCount;
    private int _clipboardInputKey;
    private bool _clipboardInteropEnabled;

    protected override async Task OnInitializedAsync()
    {
        _intakeOptions = await SettingsSvc.GetIntakeOptionsAsync();
        await RefreshQueueCountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("stashClipboardImages.enable", "scan-photo-clipboard");
        _clipboardInteropEnabled = true;
    }

    // --- Barcode / ISBN lookup path ------------------------------------------------

    private async Task OnCode(string code)
    {
        ClearIntake();
        if (_intakeOptions.QueueEnabled)
        {
            var queued = await Queue.EnqueueBarcodeAsync(code);
            await RefreshQueueCountAsync();
            Snackbar.Add($"Queued {queued.SourceCode} — ready for the next scan.", Severity.Success);
            return;
        }

        _busy = true;
        _busyText = "Looking up…";
        _result = null;
        StateHasChanged();
        _result = await Lookup.LookupAsync(code);
        _busy = false;
    }

    private void EditDraft()
    {
        Draft.Set(FromResult(_result!));
        Nav.NavigateTo("items/new");
    }

    private void AddBlank(string? code)
    {
        Draft.Set(new Item { Name = string.Empty, Code = code, ItemKindId = 7 });
        Nav.NavigateTo("items/new");
    }

    private static Item FromResult(LookupResult r) => new()
    {
        Name = r.Name ?? string.Empty,
        Code = r.Code,
        ThumbnailUrl = r.ThumbnailUrl,
        Attributes = new(r.Attributes),
        ItemKindId = KindId(r.SuggestedKind)
    };

    private static int KindId(string? kind) => kind switch
    {
        "Grocery" => 1,
        "Book" => 2,
        "Tool" => 3,
        "Electronics" => 4,
        "Media" => 5,
        "Clothing" => 6,
        _ => 7
    };

    // --- Photo intake path -----------------------------------------------------------

    private async Task OnIntakePhotoChange(InputFileChangeEventArgs e) => await OnIntakePhoto(e.File);

    private async Task OnReceiptPhotoChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        ClearIntake();
        _result = null;
        _busy = true;
        _busyText = "Saving receipt…";
        StateHasChanged();
        try
        {
            await using var upload = file.OpenReadStream(20 * 1024 * 1024);
            await Queue.EnqueueReceiptAsync(upload, file.ContentType, file.Name);
            await RefreshQueueCountAsync();
            if (_intakeOptions.QueueEnabled)
                Snackbar.Add("Receipt queued for matching to this session's items.", Severity.Success);
            else
                Nav.NavigateTo("queue");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't queue receipt: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClipboardPhotoChange(InputFileChangeEventArgs e)
    {
        try
        {
            await OnIntakePhoto(e.File);
        }
        finally
        {
            // InputFile retains its last browser file list. Replacing it and acknowledging
            // the client queue guarantees that pasting the same image again raises a change.
            _clipboardInputKey++;
            await JS.InvokeVoidAsync("stashClipboardImages.complete");
        }
    }

    private async Task OnIntakePhoto(IBrowserFile? file)
    {
        if (file is null) return;
        ClearIntake();
        _result = null;

        if (_intakeOptions.QueueEnabled)
        {
            _busy = true;
            _busyText = "Saving to queue…";
            StateHasChanged();
            try
            {
                await using var upload = file.OpenReadStream(20 * 1024 * 1024);
                await Queue.EnqueuePhotoAsync(upload, file.ContentType, file.Name, _multiMode);
                await RefreshQueueCountAsync();
                Snackbar.Add(_multiMode
                    ? "Photo queued — detected items will be split into individual crops."
                    : "Photo queued — ready for the next item.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Couldn't queue photo: {ex.Message}", Severity.Error);
            }
            finally { _busy = false; }
            return;
        }

        // Without AI, the photo still comes in: sanitize/store it and hand the user a
        // new-item draft with the photo attached.
        if (!Ai.IsEnabled)
        {
            _busy = true;
            _busyText = "Adding photo…";
            StateHasChanged();
            try
            {
                await using var upload = file.OpenReadStream(20 * 1024 * 1024);
                var stored = await Images.SaveAsync(upload, file.ContentType, file.Name);
                Draft.Set(new Item { Name = string.Empty, ItemKindId = 7, ImageId = stored.Id });
                Nav.NavigateTo("items/new");
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Couldn't add photo: {ex.Message}", Severity.Error);
            }
            finally { _busy = false; }
            return;
        }

        _busy = true;
        _busyText = _multiMode ? "Detecting items…" : "Identifying…";
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            if (_multiMode)
            {
                _multiResults = await Intake.ProcessMultiAsync(stream, file.ContentType);
                if (_multiResults.Count == 0)
                    Snackbar.Add("No items detected in the photo.", Severity.Warning);
            }
            else
            {
                var intake = await Intake.ProcessSingleAsync(stream, file.ContentType);
                if (intake.Proposal.Action == IntakeAction.IncrementExisting)
                {
                    // Fully automatic: apply immediately, offer Undo.
                    var applied = await Intake.ApplyAsync(intake);
                    _lastApplied = applied;
                    Snackbar.Add($"+{applied.By:0.##} {applied.ItemName}", Severity.Success, config =>
                    {
                        config.Action = "Undo";
                        config.ActionColor = Color.Inherit;
                        config.VisibleStateDuration = 8000;
                        config.OnClick = async _ =>
                        {
                            await Intake.UndoAsync(applied);
                            _lastApplied = null;
                            await InvokeAsync(StateHasChanged);
                        };
                    });
                }
                else
                {
                    _pendingIntake = intake; // picker or create card
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Photo intake failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyIncrementAsync(Item candidate)
    {
        if (_pendingIntake is null) return;
        var applied = await Intake.ApplyAsync(_pendingIntake, IntakeAction.IncrementExisting, candidate.Id);
        _lastApplied = applied;
        _pendingIntake = null;
        Snackbar.Add(applied.Action == IntakeAction.CreateStockLot
            ? $"Added {applied.By:0.##} {applied.ItemName} as a separate expiry lot."
            : $"+{applied.By:0.##} {applied.ItemName}", Severity.Success);
    }

    private async Task ApplyLotAsync()
    {
        if (_pendingIntake is null) return;
        var applied = await Intake.ApplyAsync(_pendingIntake);
        _lastApplied = applied;
        _pendingIntake = null;
        Snackbar.Add($"Added {applied.By:0.##} {applied.ItemName} as a separate expiry lot.", Severity.Success);
    }

    private async Task ApplyCreateAsync()
    {
        if (_pendingIntake is null) return;
        var applied = await Intake.ApplyAsync(_pendingIntake, IntakeAction.CreateNew);
        _lastApplied = applied;
        _pendingIntake = null;
        Snackbar.Add($"Added \"{applied.ItemName}\".", Severity.Success);
    }

    private void EditIntakeDraft()
    {
        if (_pendingIntake is null) return;
        Draft.Set(_pendingIntake.Proposal.Draft);
        Nav.NavigateTo("items/new");
    }

    private void ClearIntake()
    {
        _pendingIntake = null;
        _multiResults = null;
        _lastApplied = null;
    }

    private static string PlacementLabel(Item item) =>
        item.Container is not null
            ? $"{item.Container.Location?.Name} › {item.Container.Name}"
            : item.Location?.Name ?? "Unplaced";

    private static string ExpiryLabel(SpecialAttributeValue expiry) =>
        Enum.TryParse<ExpiryDateKind>(expiry.Qualifier, out var kind) ? kind switch
        {
            ExpiryDateKind.UseBy => "Use by",
            ExpiryDateKind.BestBefore => "Best before",
            _ => "Expiry"
        } : "Expiry";

    private async Task RefreshQueueCountAsync()
    {
        var counts = await Queue.GetCountsAsync();
        _queuedCount = counts.Waiting + counts.Processing + counts.Ready + counts.Failed;
    }

    public async ValueTask DisposeAsync()
    {
        // A separate component instance is created for static prerendering. It is disposed
        // without OnAfterRenderAsync ever running, and JS interop is illegal in that phase.
        if (!_clipboardInteropEnabled) return;
        try { await JS.InvokeVoidAsync("stashClipboardImages.disable"); }
        catch (JSDisconnectedException) { }
    }
}
