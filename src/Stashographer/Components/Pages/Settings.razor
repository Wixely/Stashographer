@page "/settings"
@attribute [Authorize]
@inject IAiClientProvider AiClients
@inject IAiEnrichmentService Ai
@inject SettingsService SettingsSvc
@inject QuickLinksService QuickLinks
@inject InventoryService Inventory
@inject IntakeQueueSignal QueueSignal
@inject AgentAccessService AgentAccess
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TagService Tags

<PageTitle>Settings · Stashographer</PageTitle>

<div class="d-flex justify-space-between align-center gap-2 flex-wrap mb-4">
    <div>
        <MudText Typo="Typo.h4">Settings</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Administrator configuration</MudText>
    </div>
    <form method="post" action="/auth/logout">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
    </form>
</div>

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <div class="d-flex justify-space-between align-center mb-2">
        <MudText Typo="Typo.h6">Home quick links</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">Add</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        The large buttons on the home screen. Each opens a page or a pre-filtered inventory view.
    </MudText>

    @if (_links is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="_links" Dense="true" Hover="true" T="QuickLink" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Style="width:1%"></MudTh>
                <MudTh>Label</MudTh>
                <MudTh>Opens</MudTh>
                <MudTh Style="width:1%"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudIcon Icon="@IconCatalog.Resolve(context.Icon)" /></MudTd>
                <MudTd DataLabel="Label">@context.Label</MudTd>
                <MudTd DataLabel="Opens">@TargetSummary(context)</MudTd>
                <MudTd>
                    <div class="d-flex">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                       OnClick="@(() => Move(context, -1))" />
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                       OnClick="@(() => Move(context, +1))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => Edit(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => Delete(context))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<div id="tags">
<MudPaper Class="pa-4 mb-3" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Tags</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Reusable labels group items across kinds and locations. Renaming a tag updates every assigned item.
    </MudText>
    <div class="d-flex gap-2 align-end mb-3">
        <MudTextField T="string" @bind-Value="_newTagName" Label="New tag"
                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50"
                      Class="flex-grow-1" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@string.IsNullOrWhiteSpace(_newTagName)" OnClick="AddTagAsync">
            Add tag
        </MudButton>
    </div>
    @if (_tags is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_tags.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No tags yet.</MudText>
    }
    else
    {
        <MudTable Items="_tags" Dense="true" Hover="true" T="Tag" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh Style="width:8rem">Items</MudTh>
                <MudTh Style="width:6rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    <MudTextField T="string" Value="@context.Name" ValueChanged="@(value => context.Name = value)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                </MudTd>
                <MudTd DataLabel="Items">@context.ItemCount</MudTd>
                <MudTd>
                    <div class="d-flex">
                        <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => SaveTagAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteTagAsync(context))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
</div>

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Inventory region</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Used for manual prices, AI currency fallback, printed date interpretation, and deciding what “today” means.
    </MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_defaultCurrency" Label="Default currency"
                          Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="3"
                          HelperText="Three-letter ISO code, e.g. GBP, EUR, USD" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="RegionalDateOrder" @bind-Value="_dateOrder" Label="Printed date order"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="RegionalDateOrder.DayMonthYear">Day / month / year</MudSelectItem>
                <MudSelectItem Value="RegionalDateOrder.MonthDayYear">Month / day / year</MudSelectItem>
                <MudSelectItem Value="RegionalDateOrder.YearMonthDay">Year / month / day</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_cultureName" Label="Language / region"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="BCP-47 culture, e.g. en-GB or en-US" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_timeZoneId" Label="Time zone"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="IANA or system time zone, e.g. Europe/London" />
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1 mb-2">
        Example: @DateExample
    </MudText>
    <div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveInventoryAsync">Save regional settings</MudButton>
    </div>
</MudPaper>

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Intake workflow</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Queue-first capture keeps barcode scanners and phone cameras ready for the next item.
        Processing happens in order, and earlier captures provide session context for later ones.
    </MudText>

    <MudSwitch T="bool" @bind-Value="_queueEnabled" Label="Add new captures to the queue" Color="Color.Primary" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
        Turn this off to use the original immediate lookup and validation screens.
    </MudText>
    <MudSwitch T="bool" @bind-Value="_autoProcessBarcodes" Label="Process queued barcodes automatically"
               Color="Color.Primary" Disabled="!_queueEnabled" />
    <MudSwitch T="bool" @bind-Value="_autoProcessPhotos" Label="Process queued photos automatically when AI is active"
               Color="Color.Primary" Disabled="!_queueEnabled" />
    <MudSwitch T="bool" @bind-Value="_requireReview" Label="Require item-by-item verification before changing inventory"
               Color="Color.Primary" Disabled="!_queueEnabled" />
    <MudDivider Class="my-3" />
    <MudText Typo="Typo.subtitle2">Live barcode scanning</MudText>
    <MudSwitch T="bool" @bind-Value="_continueLiveScanning" Label="Keep the camera open after each barcode"
               Color="Color.Primary" />
    <MudSwitch T="bool" @bind-Value="_promptForConsecutiveBarcodeQuantity"
               Label="Ask for quantity when the same barcode is scanned twice in a row"
               Color="Color.Primary" Disabled="!_continueLiveScanning" />
    <MudNumericField T="int" @bind-Value="_liveScanCooldownMilliseconds"
                     Label="Pause between live scans (milliseconds)" Min="500" Max="5000" Step="250"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                     Disabled="!_continueLiveScanning"
                     HelperText="A visible pause prevents accidental repeat reads. Default: 2000 ms." />
    <MudNumericField T="int" @bind-Value="_contextItemCount" Label="Earlier items supplied as session context"
                     Min="0" Max="25" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                     HelperText="Used for kind, placement, and same-object photo comparison; 0 disables session context." />

    <MudButton Class="mt-2" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveIntakeAsync">
        Save intake workflow
    </MudButton>
</MudPaper>

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <div class="d-flex justify-space-between align-center mb-2">
        <MudText Typo="Typo.h6">AI enrichment</MudText>
        @if (AiClients.IsConfigured)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small">Off</MudChip>
        }
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, Ollama, LM Studio…). Changes
        apply immediately — no restart, works inside Docker. Environment variables provide the
        defaults until settings are saved here.
    </MudText>

    <MudSwitch T="bool" @bind-Value="_aiEnabled" Label="Enable AI features" Color="Color.Primary" Class="mb-2" />

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_aiEndpoint" Label="Endpoint" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="blank = api.openai.com" HelperText="e.g. http://ollama:11434/v1" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_aiApiKeyInput" Label="API key" Variant="Variant.Outlined" Margin="Margin.Dense"
                          InputType="InputType.Password"
                          Placeholder="@(_hasStoredKey ? "•••••• (leave blank to keep saved key)" : "sk-… (local servers accept any value)")" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_aiModel" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="gpt-4o-mini" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_aiVisionModel" Label="Vision model (optional)" Variant="Variant.Outlined"
                          Margin="Margin.Dense" HelperText="Blank = same as model. Used for photo identify/detect/match." />
        </MudItem>
    </MudGrid>

    <div class="d-flex gap-2 mt-2">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAiAsync" Disabled="_aiBusy">Save &amp; apply</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NetworkCheck"
                   OnClick="TestAiAsync" Disabled="@(_aiBusy || !AiClients.IsConfigured)">
            @(_aiBusy ? "Testing…" : "Test connection")
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        The API key is stored in the app database on this machine/volume.
    </MudText>
</MudPaper>

@if (_agentAccess.ApiAvailable || _agentAccess.McpAvailable)
{
    <MudPaper Class="pa-4 mb-3" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">API &amp; MCP automation</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Deployment flags make these controls available; each endpoint must also be explicitly
            activated here. Automation can propose intake drafts but cannot accept them into inventory.
        </MudText>

        @if (_agentAccess.ApiAvailable)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-1">HTTP API</MudText>
            <MudSwitch T="bool" Value="_apiEnabled" ValueChanged="SetApiEnabled"
                       Label="Enable API" Color="Color.Primary"
                       Disabled="@(_agentAccess.ApiCredential is null)" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                @(_agentAccess.ApiCredential is null
                    ? "Generate an API key first."
                    : $"Active key ends in {_agentAccess.ApiCredential.Suffix}. Generating a new key revokes it.")
            </MudText>
            <div class="d-flex gap-2 flex-wrap mb-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key"
                           OnClick="GenerateApiKeyAsync">
                    @(_agentAccess.ApiCredential is null ? "Generate API key" : "Generate new API key")
                </MudButton>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(() => CopyAutomationAsync(ApiUrl))">Copy API URL</MudButton>
            </div>
            <MudTextField Value="@ApiUrl" Label="API base URL" Variant="Variant.Outlined"
                          Margin="Margin.Dense" ReadOnly="true" Class="mb-2" />
            @if (_newApiKey is not null)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    Copy this API key now. It will not be shown again after leaving this page.
                </MudAlert>
                <div class="d-flex gap-2 align-center mb-4">
                    <MudTextField Value="@_newApiKey" Label="New API key" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" ReadOnly="true" Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="@(() => CopyAutomationAsync(_newApiKey))" />
                </div>
            }
        }

        @if (_agentAccess.McpAvailable)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1" Class="mb-1">MCP server</MudText>
            @if (!_agentAccess.ApiAvailable)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    MCP also requires Stashographer__EnableApi=true.
                </MudAlert>
            }
            <MudSwitch T="bool" @bind-Value="_mcpEnabled" Label="Enable MCP"
                       Color="Color.Primary"
                       Disabled="@(!_apiEnabled || _agentAccess.ApiCredential is null || !_agentAccess.ApiAvailable)" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                Stateless Streamable HTTP tools backed by the same authoritative API operations.
            </MudText>
            <div class="d-flex gap-2 flex-wrap mb-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key"
                           Disabled="@(_agentAccess.ApiCredential is null)" OnClick="GenerateMcpKeyAsync">
                    @(_agentAccess.McpCredential is null ? "Generate MCP key" : "Generate new MCP key")
                </MudButton>
                @if (_agentAccess.McpCredential is not null)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error"
                               OnClick="RemoveMcpKeyAsync">Remove MCP key</MudButton>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(() => CopyAutomationAsync(McpUrl))">Copy MCP URL</MudButton>
            </div>
            <MudTextField Value="@McpUrl" Label="MCP URL" Variant="Variant.Outlined"
                          Margin="Margin.Dense" ReadOnly="true" Class="mb-2" />
            @if (_agentAccess.McpCredential is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Active MCP key ends in @_agentAccess.McpCredential.Suffix.
                </MudText>
            }
            else if (_mcpEnabled)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    MCP is enabled without its own key. Anyone who can reach this trusted network
                    endpoint can invoke every tool.
                </MudAlert>
            }
            @if (_newMcpKey is not null)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    Copy this MCP key now. It will not be shown again after leaving this page.
                </MudAlert>
                <div class="d-flex gap-2 align-center mb-3">
                    <MudTextField Value="@_newMcpKey" Label="New MCP key" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" ReadOnly="true" Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="@(() => CopyAutomationAsync(_newMcpKey))" />
                </div>
            }
        }

        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAutomationAsync">Save automation access</MudButton>
    </MudPaper>
}

<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Theme</MudText>
    <MudText Typo="Typo.body2">
        Toggle light / dark with the icon in the top bar. Your choice is remembered on this device.
    </MudText>
</MudPaper>

@code {
    private List<QuickLink>? _links;
    private List<ItemKind> _kinds = new();
    private List<Tag>? _tags;
    private string _newTagName = string.Empty;

    // AI form state (API key handled write-only: blank input keeps the stored key).
    private bool _aiEnabled;
    private string? _aiEndpoint;
    private string _aiApiKeyInput = string.Empty;
    private string _aiModel = string.Empty;
    private string? _aiVisionModel;
    private bool _hasStoredKey;
    private bool _aiBusy;

    private bool _queueEnabled = true;
    private bool _autoProcessBarcodes = true;
    private bool _autoProcessPhotos = true;
    private bool _requireReview = true;
    private int _contextItemCount = 8;
    private bool _continueLiveScanning = true;
    private bool _promptForConsecutiveBarcodeQuantity = true;
    private int _liveScanCooldownMilliseconds = 2000;
    private string _defaultCurrency = "GBP";
    private RegionalDateOrder _dateOrder = RegionalDateOrder.DayMonthYear;
    private string _cultureName = "en-GB";
    private string _timeZoneId = "Europe/London";
    private AgentAccessConfiguration _agentAccess = new(false, false, false, false, null, null);
    private bool _apiEnabled;
    private bool _mcpEnabled;
    private string? _newApiKey;
    private string? _newMcpKey;
    private string ApiUrl => Navigation.ToAbsoluteUri("api/v1").ToString();
    private string McpUrl => Navigation.ToAbsoluteUri("mcp").ToString();
    private string DateExample => _dateOrder switch
    {
        RegionalDateOrder.MonthDayYear => "03/04/2026 → 4 March 2026",
        RegionalDateOrder.YearMonthDay => "2026/04/03 → 3 April 2026",
        _ => "03/04/2026 → 3 April 2026"
    };

    protected override async Task OnInitializedAsync()
    {
        var current = AiClients.Current;
        _aiEnabled = current.Enabled;
        _aiEndpoint = current.Endpoint;
        _aiModel = current.Model;
        _aiVisionModel = current.VisionModel;
        _hasStoredKey = !string.IsNullOrWhiteSpace(current.ApiKey);

        var intake = await SettingsSvc.GetIntakeOptionsAsync();
        _queueEnabled = intake.QueueEnabled;
        _autoProcessBarcodes = intake.AutoProcessBarcodes;
        _autoProcessPhotos = intake.AutoProcessPhotos;
        _requireReview = intake.RequireReview;
        _contextItemCount = intake.ContextItemCount;
        _continueLiveScanning = intake.ContinueLiveScanning;
        _promptForConsecutiveBarcodeQuantity = intake.PromptForConsecutiveBarcodeQuantity;
        _liveScanCooldownMilliseconds = intake.LiveScanCooldownMilliseconds;
        var regional = await SettingsSvc.GetRegionalOptionsAsync();
        _defaultCurrency = regional.DefaultCurrency;
        _dateOrder = regional.DateOrder;
        _cultureName = regional.CultureName;
        _timeZoneId = regional.TimeZoneId;
        _agentAccess = await AgentAccess.GetAsync();
        _apiEnabled = _agentAccess.ApiEnabled;
        _mcpEnabled = _agentAccess.McpEnabled;

        _kinds = await Inventory.GetKindsAsync();
        await Task.WhenAll(Reload(), ReloadTagsAsync());
    }

    private async Task SaveInventoryAsync()
    {
        try
        {
            var options = new InventoryRegionalOptions
            {
                DefaultCurrency = _defaultCurrency,
                DateOrder = _dateOrder,
                CultureName = _cultureName,
                TimeZoneId = _timeZoneId
            };
            await SettingsSvc.SaveRegionalOptionsAsync(options);
            var saved = await SettingsSvc.GetRegionalOptionsAsync();
            _defaultCurrency = saved.DefaultCurrency;
            _dateOrder = saved.DateOrder;
            _cultureName = saved.CultureName;
            _timeZoneId = saved.TimeZoneId;
            Snackbar.Add("Regional settings saved.", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or System.Globalization.CultureNotFoundException
                                       or TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveIntakeAsync()
    {
        await SettingsSvc.SaveIntakeOptionsAsync(new IntakeOptions
        {
            QueueEnabled = _queueEnabled,
            AutoProcessBarcodes = _autoProcessBarcodes,
            AutoProcessPhotos = _autoProcessPhotos,
            RequireReview = _requireReview,
            ContinueLiveScanning = _continueLiveScanning,
            PromptForConsecutiveBarcodeQuantity = _promptForConsecutiveBarcodeQuantity,
            LiveScanCooldownMilliseconds = Math.Clamp(_liveScanCooldownMilliseconds, 500, 5000),
            ContextItemCount = Math.Clamp(_contextItemCount, 0, 25)
        });
        QueueSignal.Pulse();
        Snackbar.Add("Intake workflow saved.", Severity.Success);
    }

    private void SetApiEnabled(bool enabled)
    {
        _apiEnabled = enabled;
        if (!enabled) _mcpEnabled = false;
    }

    private async Task GenerateApiKeyAsync()
    {
        try
        {
            _newApiKey = (await AgentAccess.GenerateAsync(AgentSurface.Api)).Secret;
            _agentAccess = await AgentAccess.GetAsync();
            Snackbar.Add("New API key generated. Copy it now; the previous key no longer works.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task GenerateMcpKeyAsync()
    {
        try
        {
            _newMcpKey = (await AgentAccess.GenerateAsync(AgentSurface.Mcp)).Secret;
            _agentAccess = await AgentAccess.GetAsync();
            Snackbar.Add("New MCP key generated. Copy it now; the previous key no longer works.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveMcpKeyAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Remove MCP key?",
            "If MCP remains enabled, the trusted-network endpoint will become unauthenticated.",
            yesText: "Remove key",
            cancelText: "Cancel");
        if (confirmed != true) return;
        await AgentAccess.RemoveMcpKeyAsync();
        _newMcpKey = null;
        _agentAccess = await AgentAccess.GetAsync();
        Snackbar.Add("MCP key removed.", Severity.Warning);
    }

    private async Task SaveAutomationAsync()
    {
        try
        {
            await AgentAccess.UpdateEnabledAsync(_apiEnabled, _mcpEnabled);
            _agentAccess = await AgentAccess.GetAsync();
            Snackbar.Add("Automation access saved.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CopyAutomationAsync(string value)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add("Copied.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Copy was unavailable; select the value manually.", Severity.Warning);
        }
    }

    private async Task SaveAiAsync()
    {
        _aiBusy = true;
        try
        {
            var options = new AiOptions
            {
                Enabled = _aiEnabled,
                Endpoint = string.IsNullOrWhiteSpace(_aiEndpoint) ? null : _aiEndpoint!.Trim(),
                ApiKey = string.IsNullOrWhiteSpace(_aiApiKeyInput) ? AiClients.Current.ApiKey : _aiApiKeyInput.Trim(),
                Model = string.IsNullOrWhiteSpace(_aiModel) ? new AiOptions().Model : _aiModel.Trim(),
                VisionModel = string.IsNullOrWhiteSpace(_aiVisionModel) ? null : _aiVisionModel!.Trim()
            };

            await SettingsSvc.SaveAiOptionsAsync(options);
            AiClients.Reconfigure(options);

            _aiApiKeyInput = string.Empty;
            _hasStoredKey = !string.IsNullOrWhiteSpace(options.ApiKey);

            if (options.Enabled && !AiClients.IsConfigured)
                Snackbar.Add("Saved, but AI is not active — check the API key and endpoint.", Severity.Warning);
            else
                Snackbar.Add(AiClients.IsConfigured ? "AI settings applied." : "AI disabled.", Severity.Success);
        }
        finally { _aiBusy = false; }
    }

    private async Task TestAiAsync()
    {
        _aiBusy = true;
        StateHasChanged();
        try
        {
            var error = await Ai.TestConnectionAsync();
            if (error is null)
                Snackbar.Add("Connection OK — the model responded.", Severity.Success);
            else
                Snackbar.Add($"Connection failed: {error}", Severity.Error);
        }
        finally { _aiBusy = false; }
    }

    private async Task Reload() => _links = await QuickLinks.GetAllAsync();

    private async Task ReloadTagsAsync() => _tags = await Tags.GetAllAsync();

    private async Task AddTagAsync()
    {
        try
        {
            await Tags.SaveAsync(new Tag { Name = _newTagName });
            _newTagName = string.Empty;
            await ReloadTagsAsync();
            Snackbar.Add("Tag added.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveTagAsync(Tag tag)
    {
        try
        {
            await Tags.SaveAsync(tag);
            await ReloadTagsAsync();
            Snackbar.Add("Tag renamed.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteTagAsync(Tag tag)
    {
        var assignmentSummary = tag.ItemCount == 0
            ? "It is not assigned to any items."
            : $"It will be removed from {tag.ItemCount} item{(tag.ItemCount == 1 ? string.Empty : "s")}; the items will not be deleted.";
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Delete tag?", $"Delete '{tag.Name}'? {assignmentSummary}",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        await Tags.DeleteAsync(tag.Id);
        await ReloadTagsAsync();
        Snackbar.Add("Tag deleted.", Severity.Info);
    }

    private string TargetSummary(QuickLink link) => link.Target switch
    {
        QuickLinkTarget.Dashboard => "Dashboard",
        QuickLinkTarget.Scan => "Scan & add",
        QuickLinkTarget.Inventory => InventorySummary(link),
        _ => ""
    };

    private string InventorySummary(QuickLink link)
    {
        var parts = new List<string>();
        if (link.IncludeKindIds.Count > 0)
            parts.Add(KindNames(link.IncludeKindIds));
        if (link.ExcludeKindIds.Count > 0)
            parts.Add("NOT " + KindNames(link.ExcludeKindIds));
        var summary = parts.Count > 0 ? $"Inventory · {string.Join(", ", parts)}" : "Inventory (all)";
        return link.ViewMode == InventoryView.Gallery ? $"{summary} · Gallery" : summary;
    }

    private string KindNames(List<int> ids) =>
        string.Join(", ", _kinds.Where(k => ids.Contains(k.Id)).Select(k => k.Name));

    private async Task Edit(QuickLink? link)
    {
        var parameters = new DialogParameters
        {
            ["Link"] = link ?? new QuickLink { Target = QuickLinkTarget.Inventory },
            ["Kinds"] = _kinds
        };
        var dialog = await Dialogs.ShowAsync<QuickLinkDialog>(link is null ? "Add quick link" : "Edit quick link", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: QuickLink edited })
        {
            await QuickLinks.SaveAsync(edited);
            await Reload();
        }
    }

    private async Task Move(QuickLink link, int direction)
    {
        await QuickLinks.MoveAsync(link.Id, direction);
        await Reload();
    }

    private async Task Delete(QuickLink link)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete quick link", $"Delete \"{link.Label}\"?",
            yesText: "Delete", cancelText: "Cancel");
        if (ok == true)
        {
            await QuickLinks.DeleteAsync(link.Id);
            Snackbar.Add("Quick link deleted.", Severity.Info);
            await Reload();
        }
    }
}
