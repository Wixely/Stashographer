@page "/c/{Slug}"
@inject ContainerService Containers
@inject NavigationManager Nav

@* QR-label target: printed labels encode /c/{slug}. Resolves the slug and lands in the
   Places explorer so there is one browsing experience. Keep this route forever — labels
   are physical. *@

@if (_notFound)
{
    <MudAlert Severity="Severity.Error">No container matches this QR code.</MudAlert>
}
else
{
    <MudProgressCircular Indeterminate="true" />
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        var container = await Containers.GetContainerBySlugAsync(Slug);
        if (container is null)
        {
            _notFound = true;
            return;
        }
        Nav.NavigateTo($"places/{container.LocationId}/c/{container.Id}", replace: true);
    }
}
