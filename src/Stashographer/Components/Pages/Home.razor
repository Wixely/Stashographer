@page "/"
@inject QuickLinksService QuickLinks
@inject NavigationManager Nav

<PageTitle>Stashographer</PageTitle>

<div class="d-flex align-center gap-2 mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Stashographer</MudText>
</div>

@if (_links is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_links.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No quick links yet. Add some in <MudLink Href="settings">Settings</MudLink>.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var link in _links)
        {
            <MudItem xs="6" sm="4" md="3">
                <MudPaper Class="quick-tile pa-6 d-flex flex-column align-center justify-center"
                          Outlined="true" @onclick="@(() => Nav.NavigateTo(link.ToUrl()))"
                          Style="cursor:pointer;height:100%;min-height:150px">
                    <MudIcon Icon="@IconCatalog.Resolve(link.Icon)" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    <MudText Typo="Typo.h6" Align="Align.Center">@link.Label</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Data.Entities.QuickLink>? _links;

    protected override async Task OnInitializedAsync() => _links = await QuickLinks.GetAllAsync();
}
