@page "/queue"
@page "/queues"
@implements IAsyncDisposable
@inject IntakeQueueService IntakeQueue
@inject SettingsService SettingsSvc
@inject IAiEnrichmentService Ai
@inject InventoryService Inventory
@inject ContainerService Containers
@inject ISnackbar Snackbar
@inject ModifyQueueService ModifyQueue
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>Queues · Stashographer</PageTitle>

<MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="ChangeTabAsync"
         Color="Color.Primary" Border="true" Class="mb-4">
    <MudTabPanel Text="@($"Intake ({_intakeOpenCount})")" Icon="@Icons.Material.Filled.PlaylistAddCheck" />
    <MudTabPanel Text="@($"Modify ({_modifyOpenCount})")" Icon="@Icons.Material.Filled.Rule" />
    <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History" />
</MudTabs>

@if (_activeTab == 0)
{

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
    <div>
        <MudText Typo="Typo.h4">Intake queue</MudText>
        @if (_session is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Session @_session.Id · started @_session.StartedAt.ToLocalTime().ToString("g")
            </MudText>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudButton Href="scan" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">Keep adding</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="@(() => LoadAsync(true))">Refresh</MudButton>
        <MudButton Href="diagnostics" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Troubleshoot">
            Temporary logs
        </MudButton>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Flag"
                   OnClick="StartNewSessionAsync">New session</MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Success">
        Nothing needs attention. New photos and barcodes will appear here.
    </MudAlert>
}
else
{
    <div class="d-flex justify-space-between align-center mb-2">
        <MudText Typo="Typo.subtitle2">Item @(_index + 1) of @_items.Count</MudText>
        <div class="d-flex align-center gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="_index == 0"
                           OnClick="Previous" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="_index >= _items.Count - 1"
                           OnClick="Next" />
        </div>
    </div>

    @if (Current is { } queued)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                <div class="d-flex align-center gap-2">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(queued.Status)">
                        @StatusLabel(queued.Status)
                    </MudChip>
                    <MudText Typo="Typo.body2">
                        @SourceLabel(queued)
                    </MudText>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Captured @queued.CreatedAt.ToLocalTime().ToString("g")
                </MudText>
            </div>

            @if (queued.Status == IntakeQueueStatus.Processing)
            {
                <div class="d-flex align-center gap-2 py-6 justify-center">
                    <MudProgressCircular Indeterminate="true" />
                    <MudText>Processing…</MudText>
                </div>
            }
            else
            {
                @if (queued.Status == IntakeQueueStatus.Failed)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@queued.Error</MudAlert>
                }
                else if (queued.Status == IntakeQueueStatus.Pending)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        @(queued.LiveCaptureHoldUntil > DateTimeOffset.UtcNow
                            ? $"Live scan captured {queued.CaptureQuantity} in this barcode group. It will process after the brief repeat-scan window."
                            : "Waiting for processing. You can process it now or complete the fields manually.")
                    </MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12" md="4">
                        @if (queued.ImageId is { } imageId)
                        {
                            var queueImageUrl = ImageUrls.For(imageId, width: 720);
                            <MudImage Src="@queueImageUrl" Width="360" Height="280"
                                      ObjectFit="ObjectFit.Contain" Class="rounded" Style="max-width:100%" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center pa-6">
                                <MudIcon Icon="@(queued.SourceType == IntakeSourceType.Manual
                                                   ? Icons.Material.Filled.EditNote
                                                   : Icons.Material.Filled.QrCode)"
                                         Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.h6" Class="mt-2">
                                    @(queued.SourceType == IntakeSourceType.Manual
                                        ? queued.Draft.Name
                                        : queued.SourceCode)
                                </MudText>
                            </div>
                        }

                        @if (queued.SourceType != IntakeSourceType.Manual)
                        {
                            <MudButton FullWidth="true" Class="mt-2" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                                       Disabled="@(IsWorking(queued.Id) || (queued.SourceType is IntakeSourceType.Photo or IntakeSourceType.Receipt
                                                                && !Ai.IsEnabled))"
                                       OnClick="ProcessCurrentAsync">
                                @(IsWorking(queued.Id) ? "Processing…" : queued.Status switch
                                {
                                    IntakeQueueStatus.Failed => "Retry processing",
                                    IntakeQueueStatus.ReadyForReview => "Process again",
                                    _ => "Process now"
                                })
                            </MudButton>
                        }
                        @if (queued.SourceType == IntakeSourceType.Photo
                             && !queued.IsMultiPhoto
                             && queued.OriginalImageId is { } originalImageId
                             && originalImageId != queued.ImageId
                             && (queued.CaptureGroupId is null || queued.CaptureGroupId == queued.Id)
                             && queued.Status is IntakeQueueStatus.ReadyForReview or IntakeQueueStatus.Failed)
                        {
                            <MudButton FullWidth="true" Class="mt-2" Variant="Variant.Outlined"
                                       Color="Color.Info" StartIcon="@Icons.Material.Filled.SelectAll"
                                       Disabled="@(IsWorking(queued.Id) || !Ai.IsEnabled)"
                                       OnClick="RescanOriginalAsync">
                                Rescan original for all items
                            </MudButton>
                        }
                        @if (queued.SourceType is IntakeSourceType.Photo or IntakeSourceType.Receipt && !Ai.IsEnabled)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">
                                AI vision is not active; configure it in Settings to process this image.
                            </MudText>
                        }
                        @if (queued.SourceType is IntakeSourceType.Photo or IntakeSourceType.Receipt
                             && queued.Status != IntakeQueueStatus.Processing)
                        {
                            <MudButton FullWidth="true" Class="mt-2" Variant="Variant.Text"
                                       StartIcon="@(queued.SourceType == IntakeSourceType.Receipt
                                                        ? Icons.Material.Filled.Inventory2
                                                        : Icons.Material.Filled.ReceiptLong)"
                                       Disabled="@IsWorking(queued.Id)" OnClick="ReclassifyCurrentAsync">
                                @(queued.SourceType == IntakeSourceType.Receipt
                                    ? "Treat as item photo"
                                    : "Treat as receipt / order")
                            </MudButton>
                        }
                    </MudItem>

                    <MudItem xs="12" md="8">
                        @if (queued.SourceType == IntakeSourceType.Receipt)
                        {
                            @if (!queued.SourceTypeOverride)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                                    AI recognized this image as purchase evidence. If that is wrong,
                                    choose <strong>Treat as item photo</strong>.
                                </MudAlert>
                            }
                            <ReceiptReviewPanel QueueItem="queued"
                                                OnAccepted="ReceiptAcceptedAsync"
                                                OnRejected="ReceiptRejectedAsync" />
                        }
                        else
                        {
                        @if (queued.ProposalAction == IntakeAction.AttachImage)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-3">
                                <MudText Typo="Typo.subtitle2">Another view of @queued.MatchedItemName</MudText>
                                <MudText Typo="Typo.body2">
                                    The agent believes this is the same physical item. Accepting attaches the photo;
                                    quantity stays unchanged.
                                </MudText>
                                @if (!string.IsNullOrWhiteSpace(queued.RelationshipReason))
                                {
                                    <MudText Typo="Typo.caption">
                                        @ConfidenceLabel(queued.RelationshipConfidence): @queued.RelationshipReason
                                    </MudText>
                                }
                            </MudAlert>
                        }
                        else if (queued.CaptureRelationship == CaptureRelationship.Uncertain
                                 && queued.MatchedQueueItemId is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-3">
                                The photo resembles the recent capture “@queued.MatchedItemName”, but the agent
                                could not prove whether it is another view or another physical copy. Choose explicitly below;
                                this result cannot be accepted automatically.
                                @if (!string.IsNullOrWhiteSpace(queued.RelationshipReason))
                                {
                                    <div class="mt-1">@queued.RelationshipReason</div>
                                }
                            </MudAlert>
                        }
                        else if (queued.ProposalAction == IntakeAction.CreateStockLot)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                <MudText Typo="Typo.subtitle2">A separate expiry lot was detected</MudText>
                                <MudText Typo="Typo.body2">
                                    This is the same product as @queued.MatchedItemName, but its visible expiry differs.
                                    Accepting creates a linked stock entry; existing quantities and expiry dates stay unchanged.
                                </MudText>
                            </MudAlert>
                        }

                        <MudTextField @bind-Value="queued.Draft.Name" Label="Name" Variant="Variant.Outlined"
                                      Required="true" Immediate="true" Class="mb-2" />
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudSelect @bind-Value="queued.Draft.ItemKindId" Label="Kind" Variant="Variant.Outlined">
                                    @foreach (var kind in _kinds)
                                    {
                                        <MudSelectItem Value="@kind.Id">@kind.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudNumericField @bind-Value="queued.Draft.Quantity" Label="Quantity"
                                                 Variant="Variant.Outlined" Min="0"
                                                 Disabled="@(queued.ProposalAction == IntakeAction.AttachImage)" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudTextField @bind-Value="queued.Draft.Unit" Label="Unit" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                        <MudTextField @bind-Value="queued.Draft.Code" Label="Barcode / ISBN"
                                      Variant="Variant.Outlined" Class="mt-2" />
                        <MudTextField @bind-Value="queued.Draft.Description" Label="Description"
                                      Variant="Variant.Outlined" Lines="2" Class="mt-2" />

                        @if (queued.ProposalAction != IntakeAction.AttachImage)
                        {
                            <PlacementPicker Locations="_locations" Class="mt-1"
                                             @bind-LocationId="_locationId"
                                             @bind-ContainerId="_containerId" />
                        }

                        @if (queued.ProposalAction == IntakeAction.AttachImage
                             || queued.CaptureRelationship == CaptureRelationship.Uncertain)
                        {
                            <MudSelect T="ItemImageRole" @bind-Value="_imageRole" Label="Photo role"
                                       Variant="Variant.Outlined" Class="mt-2">
                                @foreach (var role in Enum.GetValues<ItemImageRole>())
                                {
                                    <MudSelectItem Value="@role">@ImageRoleLabel(role)</MudSelectItem>
                                }
                            </MudSelect>
                        }

                        <div class="mt-3">
                            <SpecialAttributeEditor Item="queued.Draft" DefaultCurrency="@_defaultCurrency" />
                            <MudDivider Class="my-3" />
                            <AttributeEditor Attributes="queued.Draft.Attributes" Suggestions="SuggestionsForKind(queued.Draft.ItemKindId)" />
                        </div>

                        @if (_candidates.Count > 0 && queued.ProposalAction != IntakeAction.AttachImage)
                        {
                            <MudSelect @bind-Value="_matchedItemId" T="int?" Label="Inventory action"
                                       Variant="Variant.Outlined" Class="mt-3" Clearable="true"
                                       HelperText="Leave blank to create a new inventory item.">
                                @foreach (var candidate in _candidates)
                                {
                                    <MudSelectItem T="int?" Value="@candidate.Id">
                                        @(queued.ProposalAction == IntakeAction.CreateStockLot
                                            ? $"Create expiry lot for {candidate.Name}"
                                            : $"Add {queued.IncrementBy:0.##} to {candidate.Name}")
                                        (@candidate.Quantity.ToString("0.##") now · @PlacementLabel(candidate))
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }

                        <div class="queue-review-actions d-flex gap-2 flex-wrap mt-4">
                            <MudButton Color="Color.Success" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Check"
                                       Disabled="@(IsWorking(queued.Id) || (queued.ProposalAction != IntakeAction.AttachImage
                                                                && _matchedItemId is null
                                                                && string.IsNullOrWhiteSpace(queued.Draft.Name)))"
                                       OnClick="AcceptCurrentAsync">
                                @(queued.ProposalAction switch
                                {
                                    IntakeAction.AttachImage => "Accept additional view",
                                    IntakeAction.CreateStockLot => "Accept expiry lot",
                                    _ => "Accept item"
                                })
                            </MudButton>
                            @if (queued.ProposalAction == IntakeAction.AttachImage)
                            {
                                <MudButton Color="Color.Warning" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Disabled="@IsWorking(queued.Id)" OnClick="AcceptCurrentAsCopyAsync">
                                    This is another copy (+@Math.Max(1, queued.Draft.Quantity).ToString("0.##"))
                                </MudButton>
                            }
                            else if (queued.CaptureRelationship == CaptureRelationship.Uncertain
                                     && queued.MatchedQueueItemId is not null)
                            {
                                <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                                           Disabled="@IsWorking(queued.Id)" OnClick="AcceptCurrentAsViewAsync">
                                    Same item — attach photo (no count)
                                </MudButton>
                            }
                            <MudButton Color="Color.Error" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Close" Disabled="@IsWorking(queued.Id)"
                                       OnClick="RejectCurrentAsync">Reject</MudButton>
                        </div>

                        @if (queued.ProposalAction != IntakeAction.AttachImage
                             && (RememberedLocation is not null || RememberedContainer is not null))
                        {
                            <MudDivider Class="my-4" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Quick add current item</MudText>
                            <div class="d-flex gap-2 flex-wrap">
                                @if (RememberedLocation is { } rememberedLocation)
                                {
                                    <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Room"
                                               Disabled="@(IsWorking(queued.Id) || (_matchedItemId is null && string.IsNullOrWhiteSpace(queued.Draft.Name)))"
                                               OnClick="QuickAddToLocationAsync">
                                        Quick add to location: @rememberedLocation.Name
                                    </MudButton>
                                }
                                @if (RememberedContainer is { } rememberedContainer)
                                {
                                    <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Inbox"
                                               Disabled="@(IsWorking(queued.Id) || (_matchedItemId is null && string.IsNullOrWhiteSpace(queued.Draft.Name)))"
                                               OnClick="QuickAddToContainerAsync">
                                        Quick add to container: @ContainerLabel(rememberedContainer)
                                    </MudButton>
                                }
                            </div>
                        }
                        }
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
    }
}
}
else if (_activeTab == 1)
{
    <ModifyQueuePanel OnChanged="RefreshQueueCountsAsync" />
}
else
{
    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
        <div>
            <MudText Typo="Typo.h4">Intake history</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                All scan results grouped with their original capture and derived images.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_historyLoading" OnClick="LoadHistoryAsync">Refresh</MudButton>
    </div>

    @if (_historyLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_history.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No scans yet. New and reviewed intake captures will appear here.
        </MudAlert>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var capture in _history)
            {
                <MudPaper Class="pa-4" Outlined="true">
                    <div class="d-flex justify-space-between align-start flex-wrap gap-2 mb-3">
                        <div>
                            <MudText Typo="Typo.h6">@HistorySourceLabel(capture)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Captured @capture.CapturedAt.ToLocalTime().ToString("g") ·
                                last activity @capture.LastActivityAt.ToLocalTime().ToString("g")
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @capture.Entries.Count @(capture.Entries.Count == 1 ? "result" : "results")
                            </MudChip>
                            @if (!capture.IsComplete)
                            {
                                var awaitingReview = capture.Entries.Count(IsOpenHistoryEntry);
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                    @awaitingReview awaiting review
                                </MudChip>
                            }
                            @if (capture.SourceType != IntakeSourceType.Manual)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Replay"
                                           Disabled="@(!capture.IsComplete
                                                       || _historyRerunIds.Contains(capture.CaptureGroupId)
                                                       || (capture.SourceType is IntakeSourceType.Photo or IntakeSourceType.Receipt
                                                           && !Ai.IsEnabled))"
                                           OnClick="@(() => RerunHistoryCaptureAsync(capture.CaptureGroupId))">
                                    @(_historyRerunIds.Contains(capture.CaptureGroupId)
                                        ? "Rerunning..."
                                        : capture.OriginalImageId is not null
                                            ? "Rerun original"
                                            : "Rerun scan")
                                </MudButton>
                            }
                        </div>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.overline">Original capture</MudText>
                            @if (capture.OriginalImageId is { } originalImageId)
                            {
                                <MudImage Src="@ImageUrls.For(originalImageId, width: 720)"
                                          Width="360" Height="260" ObjectFit="ObjectFit.Contain"
                                          Class="rounded" Style="max-width:100%" />
                            }
                            else
                            {
                                <div class="d-flex align-center gap-2 pa-4">
                                    <MudIcon Icon="@(capture.SourceType == IntakeSourceType.Barcode
                                                       ? Icons.Material.Filled.QrCode
                                                       : Icons.Material.Filled.EditNote)"
                                             Color="Color.Primary" />
                                    <MudText Typo="Typo.body2">@(capture.SourceCode ?? "Manual entry")</MudText>
                                </div>
                            }
                        </MudItem>
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.overline">Derived items and images</MudText>
                            <MudGrid Spacing="2">
                                @foreach (var entry in capture.Entries)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudPaper Class="pa-3 h-100" Outlined="true">
                                            <div class="d-flex gap-3 align-start">
                                                @if (entry.ImageId is { } entryImageId)
                                                {
                                                    <MudImage Src="@ImageUrls.For(entryImageId, width: 240)"
                                                              Width="96" Height="96" ObjectFit="ObjectFit.Contain"
                                                              Class="rounded flex-shrink-0" />
                                                }
                                                <div style="min-width:0" class="flex-grow-1">
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@HistoryStatusColor(entry.Status)">
                                                        @StatusLabel(entry.Status)
                                                    </MudChip>
                                                    <MudText Typo="Typo.subtitle2" Class="mt-1"
                                                             Style="overflow-wrap:anywhere">
                                                        @HistoryEntryName(entry)
                                                    </MudText>
                                                    @if (entry.AppliedItemId is { } appliedItemId)
                                                    {
                                                        <MudButton Href="@($"items/{appliedItemId}")"
                                                                   Variant="Variant.Text" Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.Inventory2"
                                                                   Class="mt-1 px-0">
                                                            View inventory item
                                                        </MudButton>
                                                    }
                                                    @if (entry.Status == IntakeQueueStatus.Accepted)
                                                    {
                                                        <MudButton Variant="Variant.Text" Color="Color.Warning"
                                                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Undo"
                                                                   Disabled="@_historyUndoIds.Contains(entry.Id)"
                                                                   OnClick="@(() => UndoHistoryEntryAsync(entry.Id))"
                                                                   Class="mt-1">
                                                            @(_historyUndoIds.Contains(entry.Id) ? "Undoing..." : "Undo changes")
                                                        </MudButton>
                                                    }
                                                    else if (IsOpenHistoryEntry(entry))
                                                    {
                                                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.RateReview"
                                                                   OnClick="@(() => ReviewHistoryEntryAsync(entry.Id))"
                                                                   Class="mt-1">
                                                            Review in Intake
                                                        </MudButton>
                                                    }
                                                </div>
                                            </div>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </div>

        @if (_history.Count >= _historyTake && _historyTake < 100)
        {
            <div class="d-flex justify-center mt-4">
                <MudButton Variant="Variant.Outlined" Disabled="_historyLoading"
                           OnClick="LoadMoreHistoryAsync">Load more</MudButton>
            </div>
        }
    }
}

@code {
    private static string SourceLabel(IntakeQueueItem item) => item.SourceType switch
    {
        IntakeSourceType.Barcode => item.SourceCode ?? "Barcode",
        IntakeSourceType.Photo => item.IsMultiPhoto ? "Multi-item photo" : "Photo",
        IntakeSourceType.Receipt => "Purchase evidence",
        _ => "Automation draft"
    };

    private static string HistorySourceLabel(IntakeCaptureHistory capture) => capture.SourceType switch
    {
        IntakeSourceType.Barcode => capture.SourceCode ?? "Barcode scan",
        IntakeSourceType.Photo => capture.Entries.Count > 1
                                  || capture.Entries.Any(item => item.IsMultiPhoto
                                      || item.CaptureGroupId != item.Id)
            ? "Multi-item photo"
            : "Photo",
        IntakeSourceType.Receipt => "Purchase evidence",
        _ => "Manual entry"
    };

    private static string HistoryEntryName(IntakeQueueItem item) =>
        !string.IsNullOrWhiteSpace(item.Draft.Name)
            ? item.Draft.Name
            : item.SourceCode ?? "Unnamed item";

    private static Color HistoryStatusColor(IntakeQueueStatus status) => status switch
    {
        IntakeQueueStatus.Accepted => Color.Success,
        IntakeQueueStatus.Rejected => Color.Default,
        IntakeQueueStatus.Undone => Color.Warning,
        IntakeQueueStatus.Failed => Color.Error,
        _ => Color.Info
    };

    private static bool IsOpenHistoryEntry(IntakeQueueItem item) => item.Status is not
        (IntakeQueueStatus.Accepted or IntakeQueueStatus.Rejected or IntakeQueueStatus.Undone);

    private readonly CancellationTokenSource _dispose = new();
    private List<IntakeQueueItem> _items = new();
    private List<ItemKind> _kinds = new();
    private List<Location> _locations = new();
    private List<Item> _candidates = new();
    private IntakeSession? _session;
    private IntakeOptions _options = new();
    private int _index;
    private int? _matchedItemId;
    private int? _locationId;
    private int? _containerId;
    private int? _rememberedLocationId;
    private int? _rememberedContainerId;
    private ItemImageRole _imageRole = ItemImageRole.Detail;
    private bool _loading = true;
    private readonly HashSet<int> _workingItemIds = [];
    private string _defaultCurrency = "GBP";
    private int _activeTab;
    private int _intakeOpenCount;
    private int _modifyOpenCount;
    private List<IntakeCaptureHistory> _history = new();
    private bool _historyLoading;
    private int _historyTake = 25;
    private readonly HashSet<int> _historyRerunIds = [];
    private readonly HashSet<int> _historyUndoIds = [];

    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private IntakeQueueItem? Current => _items.Count == 0 ? null : _items[Math.Clamp(_index, 0, _items.Count - 1)];
    private Location? RememberedLocation => _locations.FirstOrDefault(x => x.Id == _rememberedLocationId);
    private Container? RememberedContainer => _locations.SelectMany(x => x.Containers)
        .FirstOrDefault(x => x.Id == _rememberedContainerId);

    protected override async Task OnInitializedAsync()
    {
        await RefreshQueueCountsAsync();
        _activeTab = QueueTabSelection.InitialIndex(
            RequestedTab, _intakeOpenCount, _modifyOpenCount);
        _options = await SettingsSvc.GetIntakeOptionsAsync();
        _defaultCurrency = await SettingsSvc.GetDefaultCurrencyAsync();
        _kinds = await Inventory.GetKindsAsync();
        _locations = await Containers.GetLocationsAsync();
        _session = await IntakeQueue.GetCurrentSessionAsync();
        await LoadRememberedDestinationsAsync();
        await LoadAsync(false);
        if (_activeTab == 2) await LoadHistoryAsync();
        _ = RefreshLoopAsync();
    }

    private async Task ChangeTabAsync(int index)
    {
        _activeTab = index;
        var tab = index switch { 1 => "modify", 2 => "history", _ => "intake" };
        Navigation.NavigateTo($"queues?tab={tab}", replace: true);
        if (index == 2) await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        try
        {
            _history = await IntakeQueue.GetHistoryAsync(_historyTake, _dispose.Token);
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private async Task LoadMoreHistoryAsync()
    {
        _historyTake = Math.Min(100, _historyTake + 25);
        await LoadHistoryAsync();
    }

    private async Task RerunHistoryCaptureAsync(int captureGroupId)
    {
        if (!_historyRerunIds.Add(captureGroupId)) return;
        try
        {
            var rerun = await IntakeQueue.RerunHistoryCaptureAsync(
                captureGroupId, _options, Ai.IsEnabled, _dispose.Token);
            Snackbar.Add(rerun.Status == IntakeQueueStatus.Failed
                ? "The original capture was added back to Intake, but processing failed. Open Intake to review the error."
                : "The original capture was rerun and added to the Intake queue for review.",
                rerun.Status == IntakeQueueStatus.Failed ? Severity.Warning : Severity.Success);
            await RefreshQueueCountsAsync();
            await LoadAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _historyRerunIds.Remove(captureGroupId);
        }
    }

    private async Task ReviewHistoryEntryAsync(int id)
    {
        await LoadAsync(false);
        var index = _items.FindIndex(item => item.Id == id);
        if (index >= 0)
        {
            _index = index;
            await LoadCurrentStateAsync();
        }
        await ChangeTabAsync(0);
    }

    private async Task UndoHistoryEntryAsync(int id)
    {
        if (!_historyUndoIds.Add(id)) return;
        try
        {
            var preview = await IntakeQueue.GetUndoPreviewAsync(id, _dispose.Token);
            if (!preview.CanUndo)
            {
                Snackbar.Add(string.Join(" ", preview.Effects), Severity.Warning);
                return;
            }
            var summary = "This will:\n\n- " + string.Join("\n- ", preview.Effects);
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                "Undo accepted import", summary,
                yesText: "Undo changes", cancelText: "Keep changes");
            if (confirmed != true) return;

            await IntakeQueue.UndoAcceptedAsync(id, _dispose.Token);
            Snackbar.Add("The accepted import changes were undone.", Severity.Success);
            await LoadHistoryAsync();
            await RefreshQueueCountsAsync();
            await LoadAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _historyUndoIds.Remove(id);
        }
    }

    private async Task RefreshQueueCountsAsync()
    {
        var intake = await IntakeQueue.GetCountsAsync();
        var modify = await ModifyQueue.GetCountsAsync();
        _intakeOpenCount = intake.Waiting + intake.Processing + intake.Ready + intake.Failed;
        _modifyOpenCount = modify.Open;
    }

    private async Task LoadAsync(bool preserveIndex)
    {
        var currentId = preserveIndex ? Current?.Id : null;
        _items = await IntakeQueue.GetOpenAsync();
        _intakeOpenCount = _items.Count;
        _index = currentId is { } id ? Math.Max(0, _items.FindIndex(x => x.Id == id)) : 0;
        if (_items.Count > 0 && _index >= _items.Count) _index = _items.Count - 1;
        await LoadCurrentStateAsync();
        _loading = false;
    }

    private async Task LoadCurrentStateAsync()
    {
        var current = Current;
        if (current is null)
        {
            _candidates.Clear();
            return;
        }

        _locationId = current.Draft.LocationId;
        _containerId = current.Draft.ContainerId;
        if (_containerId is { } containerId)
            _locationId = _locations.SelectMany(x => x.Containers).FirstOrDefault(x => x.Id == containerId)?.LocationId;

        _candidates = await Inventory.FindCandidatesAsync(current.Draft.Name, current.Draft.Code);
        _matchedItemId = current.ProposalAction == IntakeAction.IncrementExisting
            || current.ProposalAction == IntakeAction.ChooseCandidate
            || current.ProposalAction == IntakeAction.CreateStockLot
                ? current.MatchedItemId
                : null;
        _imageRole = current.SuggestedImageRole ?? ItemImageRole.Detail;
    }

    private async Task ProcessCurrentAsync()
    {
        if (Current is not { } current) return;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            if (current.LiveCaptureHoldUntil is not null)
                await IntakeQueue.FinalizeLiveBarcodeAsync(current.Id);
            if (!await IntakeQueue.ProcessAsync(current.Id, _options, Ai.IsEnabled))
                Snackbar.Add("This queue item changed before it could be processed. Refresh and try again.", Severity.Warning);
            await LoadAsync(true);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task ReclassifyCurrentAsync()
    {
        if (Current is not { } current) return;
        var sourceType = current.SourceType == IntakeSourceType.Receipt
            ? IntakeSourceType.Photo
            : IntakeSourceType.Receipt;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            await IntakeQueue.ReclassifyImageAsync(current.Id, sourceType);
            Snackbar.Add(sourceType == IntakeSourceType.Receipt
                ? "Marked as purchase evidence. It is ready to process."
                : "Marked as an item photo. It is ready to process.", Severity.Success);
            await LoadAsync(true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task RescanOriginalAsync()
    {
        if (Current is not { } current) return;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            if (!await IntakeQueue.ReprocessOriginalAsMultiAsync(
                    current.Id, _options, Ai.IsEnabled))
                Snackbar.Add("This queue item changed before it could be rescanned. Refresh and try again.",
                    Severity.Warning);
            await LoadAsync(true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task AcceptCurrentAsync()
        => await AcceptCurrentAtAsync(_locationId, _containerId);

    private async Task AcceptCurrentAtAsync(int? locationId, int? containerId)
    {
        if (Current is not { } current) return;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            current.Draft.ContainerId = containerId;
            current.Draft.LocationId = containerId is null ? locationId : null;
            var applied = current.ProposalAction == IntakeAction.AttachImage
                ? await IntakeQueue.AcceptImageAttachmentAsync(current.Id, current.Draft, _imageRole)
                : await IntakeQueue.AcceptAsync(current.Id, current.Draft, _matchedItemId);
            ShowAccepted(applied);
            await LoadRememberedDestinationsAsync();
            await LoadAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task AcceptCurrentAsViewAsync()
    {
        if (Current is not { } current) return;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            var applied = await IntakeQueue.AcceptImageAttachmentAsync(current.Id, current.Draft, _imageRole);
            ShowAccepted(applied);
            await LoadAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task AcceptCurrentAsCopyAsync()
    {
        if (Current is not { } current) return;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            var applied = await IntakeQueue.AcceptAdditionalCopyAsync(current.Id, current.Draft);
            ShowAccepted(applied);
            await LoadAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task ReceiptAcceptedAsync(ReceiptApplied applied)
    {
        var existingItems = applied.MatchedItems - applied.CreatedItems;
        var message = applied.CreatedItems > 0
            ? $"Created {applied.CreatedItems} new item{(applied.CreatedItems == 1 ? string.Empty : "s")} from the receipt"
              + (existingItems > 0
                  ? $" and linked {existingItems} existing item{(existingItems == 1 ? string.Empty : "s")}."
                  : ".")
            : $"Purchase evidence linked to {existingItems} item{(existingItems == 1 ? string.Empty : "s")}. Existing quantities were not changed.";
        Snackbar.Add(message, Severity.Success);
        await LoadAsync(false);
    }

    private async Task ReceiptRejectedAsync()
    {
        Snackbar.Add("Purchase evidence rejected.", Severity.Info);
        await LoadAsync(false);
    }

    private void ShowAccepted(IntakeApplied applied) => Snackbar.Add(applied.Action switch
    {
        IntakeAction.AttachImage => $"Attached a {ImageRoleLabel(_imageRole).ToLowerInvariant()} image to {applied.ItemName}. Quantity was not changed.",
        IntakeAction.CreateStockLot => $"Added {applied.By:0.##} {applied.ItemName} as a separate expiry lot.",
        IntakeAction.IncrementExisting => $"Added {applied.By:0.##} to {applied.ItemName}.",
        _ => $"Added {applied.ItemName} to inventory."
    }, Severity.Success);

    private async Task RejectCurrentAsync()
    {
        if (Current is not { } current) return;
        if (!_workingItemIds.Add(current.Id)) return;
        try
        {
            await IntakeQueue.RejectAsync(current.Id);
            Snackbar.Add("Queue item rejected.", Severity.Info);
            await LoadAsync(false);
        }
        finally { _workingItemIds.Remove(current.Id); }
    }

    private async Task StartNewSessionAsync()
    {
        _session = await IntakeQueue.StartNewSessionAsync();
        _rememberedLocationId = null;
        _rememberedContainerId = null;
        Snackbar.Add("New intake session started. Context has been reset.", Severity.Success);
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(_dispose.Token))
            {
                // Pending records may be being completed manually; do not reload underneath
                // the user's typing. Processing records are read-only and safe to refresh.
                if (Current is { } current
                    && !IsWorking(current.Id)
                    && current.Status == IntakeQueueStatus.Processing)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync(true);
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task Previous()
    {
        if (_index == 0) return;
        _index--;
        await LoadCurrentStateAsync();
    }

    private async Task Next()
    {
        if (_index >= _items.Count - 1) return;
        _index++;
        await LoadCurrentStateAsync();
    }

    private bool IsWorking(int queueItemId) => _workingItemIds.Contains(queueItemId);

    private Task QuickAddToLocationAsync() =>
        AcceptCurrentAtAsync(_rememberedLocationId, null);

    private Task QuickAddToContainerAsync() =>
        AcceptCurrentAtAsync(null, _rememberedContainerId);

    private async Task LoadRememberedDestinationsAsync()
    {
        if (_session is null) return;
        var remembered = await IntakeQueue.GetRememberedDestinationsAsync(_session.Id);
        _rememberedLocationId = remembered.LocationId;
        _rememberedContainerId = remembered.ContainerId;
    }

    private string ContainerLabel(Container container)
    {
        var location = _locations.FirstOrDefault(x => x.Id == container.LocationId)?.Name;
        return string.IsNullOrWhiteSpace(location) ? container.Name : $"{location} › {container.Name}";
    }

    private static string PlacementLabel(Item item) =>
        item.Container is not null
            ? $"{item.Container.Location?.Name} › {item.Container.Name}"
            : item.Location?.Name ?? "Unplaced";

    private List<string>? SuggestionsForKind(int kindId) =>
        _kinds.FirstOrDefault(x => x.Id == kindId)?.SuggestedAttributes;

    private static string ConfidenceLabel(MatchConfidence? confidence) => confidence switch
    {
        MatchConfidence.High => "High confidence",
        MatchConfidence.Medium => "Medium confidence",
        MatchConfidence.Low => "Low confidence",
        _ => "Unverified"
    };

    private static string ImageRoleLabel(ItemImageRole role) => role switch
    {
        ItemImageRole.Front => "Front",
        ItemImageRole.Back => "Back",
        ItemImageRole.Detail => "Detail",
        ItemImageRole.Label => "Label",
        ItemImageRole.Receipt => "Receipt",
        _ => "Other"
    };

    private static string StatusLabel(IntakeQueueStatus status) => status switch
    {
        IntakeQueueStatus.Pending => "Waiting",
        IntakeQueueStatus.Processing => "Processing",
        IntakeQueueStatus.ReadyForReview => "Ready to verify",
        IntakeQueueStatus.Failed => "Needs attention",
        IntakeQueueStatus.Undone => "Undone",
        _ => status.ToString()
    };

    private static Color StatusColor(IntakeQueueStatus status) => status switch
    {
        IntakeQueueStatus.ReadyForReview => Color.Success,
        IntakeQueueStatus.Failed => Color.Error,
        IntakeQueueStatus.Processing => Color.Info,
        _ => Color.Default
    };

    public ValueTask DisposeAsync()
    {
        _dispose.Cancel();
        _dispose.Dispose();
        return ValueTask.CompletedTask;
    }
}
