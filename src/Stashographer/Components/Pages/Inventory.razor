@page "/inventory"
@inject InventoryService InventorySvc
@inject ConsumptionService Consumption
@inject ContainerService Containers
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject TagService Tags

<PageTitle>Inventory · Stashographer</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Inventory</MudText>
    <div class="d-flex gap-2 align-center flex-wrap">
        @if (_selectedIds.Count > 0)
        {
            <MudChip T="string" Color="Color.Primary">@_selectedIds.Count selected</MudChip>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DriveFileMove"
                       OnClick="OpenQuickMoveAsync">Quick Move</MudButton>
            <MudButton Variant="Variant.Text" OnClick="ClearSelection">Clear</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   Href="scan">Add item</MudButton>
    </div>
</div>

<MudPaper Class="pa-3 mb-3" Outlined="true">
    <div class="d-flex gap-2 align-center mb-2">
        <MudTextField @bind-Value="_search" Placeholder="Search name, code, description, tags" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300"
                      OnDebounceIntervalElapsed="ReloadAsync" Class="flex-grow-1" />
        <MudToggleGroup T="InventoryView" Value="CurrentView" ValueChanged="SetView"
                        Outlined="true" Size="Size.Small" Color="Color.Primary">
            <MudToggleItem T="InventoryView" Value="InventoryView.List">
                <MudTooltip Text="List — dense table"><MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" /></MudTooltip>
            </MudToggleItem>
            <MudToggleItem T="InventoryView" Value="InventoryView.Gallery">
                <MudTooltip Text="Gallery — cover grid"><MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" /></MudTooltip>
            </MudToggleItem>
        </MudToggleGroup>
        <MudSelect T="ItemSort" Value="_sort" ValueChanged="SetSortAsync" Label="Sort"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:11rem">
            <MudSelectItem Value="ItemSort.Name">Name</MudSelectItem>
            <MudSelectItem Value="ItemSort.PriceLowToHigh">Price within currency ↑</MudSelectItem>
            <MudSelectItem Value="ItemSort.PriceHighToLow">Price within currency ↓</MudSelectItem>
        </MudSelect>
    </div>

    <div class="d-flex align-center flex-wrap gap-2">
        <MudText Typo="Typo.body2" Class="mr-1">Kinds:</MudText>
        @foreach (var k in _kinds)
        {
            var mode = _kindFilter.GetValueOrDefault(k.Id);
            <MudChip T="string" Size="Size.Small"
                     Variant="@(mode == FilterMode.Off ? Variant.Outlined : Variant.Filled)"
                     Color="@ChipColor(mode)"
                     Icon="@(mode == FilterMode.Exclude ? Icons.Material.Filled.Block : null)"
                     OnClick="@(() => CycleKindAsync(k.Id))">
                @(mode == FilterMode.Exclude ? $"NOT {k.Name}" : k.Name)
            </MudChip>
        }
        @if (_kindFilter.Values.Any(m => m != FilterMode.Off))
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearKindFiltersAsync">Clear</MudButton>
        }
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Click a kind to include it, again to exclude (NOT), again to clear. Multiple includes are combined (any match).
    </MudText>
    @if (_tags.Count > 0)
    {
        <div class="d-flex align-center flex-wrap gap-2 mt-3">
            <MudText Typo="Typo.body2" Class="mr-1">Tags:</MudText>
            @foreach (var tag in _tags)
            {
                var mode = _tagFilter.GetValueOrDefault(tag.Id);
                <MudChip T="string" Size="Size.Small"
                         Variant="@(mode == FilterMode.Off ? Variant.Outlined : Variant.Filled)"
                         Color="@ChipColor(mode)"
                         Icon="@(mode == FilterMode.Exclude ? Icons.Material.Filled.Block : Icons.Material.Filled.Label)"
                         OnClick="@(() => CycleTagAsync(tag.Id))">
                    @(mode == FilterMode.Exclude ? $"NOT {tag.Name}" : tag.Name)
                </MudChip>
            }
            @if (_tagFilter.Values.Any(mode => mode != FilterMode.Off))
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearTagFiltersAsync">Clear</MudButton>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Included tags must all be present. An excluded tag removes an item from the results.
        </MudText>
    }
    @if (CurrentView == InventoryView.List)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
            Click to select, Ctrl+click to toggle, drag across rows to select several, or double-click to open an item.
        </MudText>
    }
</MudPaper>

@if (_contextMenuOpen)
{
    <div class="inventory-context-scrim" @onclick="CloseContextMenu"></div>
    <MudPaper Class="inventory-context-menu pa-1" Style="@ContextMenuStyle" Elevation="8">
        <MudButton FullWidth="true" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DriveFileMove"
                   OnClick="OpenQuickMoveAsync">Quick Move @_selectedIds.Count selected</MudButton>
    </MudPaper>
}

@if (_items is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No items match. Try scanning something in.</MudAlert>
}
else if (CurrentView == InventoryView.Gallery)
{
    <MudGrid Spacing="2">
        @foreach (var item in _items)
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <div class="cover-card" @onclick="@(() => Nav.NavigateTo($"items/{item.Id}"))">
                    <div class="cover-media">
                        @{ var cover = ImageUrls.For(item.ImageId, item.ThumbnailUrl, 480); }
                        @if (cover is not null)
                        {
                            <img src="@cover" alt="@item.Name" loading="lazy" />
                        }
                        else
                        {
                            <MudIcon Icon="@IconCatalog.Resolve(item.Kind?.Icon)" Class="cover-kind-icon" />
                        }
                    </div>
                    <div class="cover-body">
                        <MudText Typo="Typo.subtitle2" Class="cover-title" title="@item.Name">@item.Name</MudText>
                        <div class="d-flex align-center gap-1 flex-wrap">
                            <MudChip T="string" Size="Size.Small">@($"{item.Quantity:0.##} {item.Unit}".Trim())</MudChip>
                            @if (SpecialAttributeCatalog.GetPrice(item) is { } price)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@SpecialAttributeCatalog.FormatPrice(price)</MudChip>
                            }
                            @if (item.IsCheckedOut)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Out</MudChip>
                            }
                            @foreach (var tag in item.Tags.Take(2))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Label">@tag.Name</MudChip>
                            }
                            @if (item.Tags.Count > 2)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">+@(item.Tags.Count - 2)</MudChip>
                            }
                        </div>
                    </div>
                </div>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudTable Items="_items" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true"
              OnRowClick="OnRowClick" OnRowMouseEnter="OnRowMouseEnter" OnRowMouseLeave="OnRowMouseLeave"
              RowClassFunc="RowClass" RowStyleFunc="RowStyle" T="Item">
        <HeaderContent>
            <MudTh Style="width:2.5rem"></MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Kind</MudTh>
            <MudTh>Location</MudTh>
            <MudTh Style="text-align:right">Qty</MudTh>
            <MudTh Style="text-align:right">Unit price</MudTh>
            <MudTh Style="text-align:center">Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Selected">
                <div @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))" @oncontextmenu:preventDefault>
                    <MudCheckBox T="bool" Value="@_selectedIds.Contains(context.Id)"
                                 ValueChanged="@(selected => SetSelected(context.Id, selected))"
                                 @onclick:stopPropagation="true" />
                </div>
            </MudTd>
            <MudTd DataLabel="Name">
                <div class="d-flex align-center gap-2" @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))"
                     @oncontextmenu:preventDefault>
                    @{ var thumb = ImageUrls.For(context.ImageId, context.ThumbnailUrl, 80); }
                    @if (thumb is not null)
                    {
                        <MudAvatar Size="Size.Small"><MudImage Src="@thumb" /></MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Size="Size.Small">
                            <MudIcon Icon="@IconCatalog.Resolve(context.Kind?.Icon)" Size="Size.Small" />
                        </MudAvatar>
                    }
                    <span>@context.Name</span>
                    @if (context.CollectionKey is not null)
                    {
                        <MudTooltip Text="Part of a product collection split by expiry lot or place">
                            <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" Color="Color.Primary" />
                        </MudTooltip>
                    }
                    @foreach (var tag in context.Tags.Take(2))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag.Name</MudChip>
                    }
                    @if (context.Tags.Count > 2)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">+@(context.Tags.Count - 2)</MudChip>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Kind">
                <div @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))" @oncontextmenu:preventDefault>@context.Kind?.Name</div>
            </MudTd>
            <MudTd DataLabel="Location">
                <div @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))" @oncontextmenu:preventDefault>@LocationLabel(context)</div>
            </MudTd>
            <MudTd DataLabel="Qty" Style="text-align:right">
                <div class="d-flex align-center justify-end gap-1" @onclick:stopPropagation="true"
                     @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))" @oncontextmenu:preventDefault>
                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                   Disabled="@(context.Quantity < 1)"
                                   OnClick="@(() => Adjust(context, -1))" />
                    <span style="min-width:2.5rem;text-align:center">@context.Quantity.ToString("0.##") @context.Unit</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                   OnClick="@(() => Adjust(context, +1))" />
                </div>
            </MudTd>
            <MudTd DataLabel="Unit price" Style="text-align:right">
                <div @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))" @oncontextmenu:preventDefault>
                    @SpecialAttributeCatalog.FormatPrice(SpecialAttributeCatalog.GetPrice(context))
                </div>
            </MudTd>
            <MudTd DataLabel="Status" Style="text-align:center">
                <div @oncontextmenu="@((MouseEventArgs e) => OpenContextMenu(e, context))" @oncontextmenu:preventDefault>
                    @if (context.IsCheckedOut)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Out</MudChip>
                    }
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private enum FilterMode { Off, Include, Exclude }

    [SupplyParameterFromQuery(Name = "include")] public string? IncludeParam { get; set; }
    [SupplyParameterFromQuery(Name = "exclude")] public string? ExcludeParam { get; set; }
    [SupplyParameterFromQuery(Name = "includeTags")] public string? IncludeTagsParam { get; set; }
    [SupplyParameterFromQuery(Name = "excludeTags")] public string? ExcludeTagsParam { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }

    // The URL is the single source of truth for the view, so quick links can deep-link it
    // and back/refresh/share all behave.
    private InventoryView CurrentView =>
        string.Equals(ViewParam, "gallery", StringComparison.OrdinalIgnoreCase)
            ? InventoryView.Gallery
            : InventoryView.List;

    private void SetView(InventoryView view)
    {
        ClearSelection();
        Nav.NavigateTo(
            Nav.GetUriWithQueryParameter("view", view == InventoryView.Gallery ? "gallery" : null),
            replace: true);
    }

    private List<Item>? _items;
    private List<ItemKind> _kinds = new();
    private List<Location> _locations = new();
    private List<Tag> _tags = new();
    private string? _search;
    private ItemSort _sort = ItemSort.Name;
    private readonly Dictionary<int, FilterMode> _kindFilter = new();
    private readonly Dictionary<int, FilterMode> _tagFilter = new();
    private readonly HashSet<int> _selectedIds = new();
    private readonly HashSet<int> _dragVisited = new();
    private bool _dragSelecting;
    private bool _dragSelectValue;
    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private string ContextMenuStyle =>
        $"--inventory-context-x:{Math.Max(8, _contextMenuX):0}px;--inventory-context-y:{Math.Max(8, _contextMenuY):0}px";

    protected override async Task OnInitializedAsync()
    {
        _kinds = await InventorySvc.GetKindsAsync();
        _locations = await Containers.GetLocationsAsync();
        _tags = await Tags.GetAllAsync();
        foreach (var k in _kinds) _kindFilter[k.Id] = FilterMode.Off;
        foreach (var tag in _tags) _tagFilter[tag.Id] = FilterMode.Off;
        // Preset filters when arriving from a home quick link (e.g. /inventory?include=1&exclude=2).
        ApplyQueryFilter(IncludeParam, FilterMode.Include, _kindFilter);
        ApplyQueryFilter(ExcludeParam, FilterMode.Exclude, _kindFilter);
        ApplyQueryFilter(IncludeTagsParam, FilterMode.Include, _tagFilter);
        ApplyQueryFilter(ExcludeTagsParam, FilterMode.Exclude, _tagFilter);
        await ReloadAsync();
    }

    private static void ApplyQueryFilter(
        string? csv, FilterMode mode, Dictionary<int, FilterMode> filters)
    {
        if (string.IsNullOrWhiteSpace(csv)) return;
        foreach (var part in csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            if (int.TryParse(part, out var id) && filters.ContainsKey(id))
                filters[id] = mode;
    }

    private async Task ReloadAsync()
    {
        var include = _kindFilter.Where(kv => kv.Value == FilterMode.Include).Select(kv => kv.Key).ToList();
        var exclude = _kindFilter.Where(kv => kv.Value == FilterMode.Exclude).Select(kv => kv.Key).ToList();
        var includeTags = _tagFilter.Where(kv => kv.Value == FilterMode.Include).Select(kv => kv.Key).ToList();
        var excludeTags = _tagFilter.Where(kv => kv.Value == FilterMode.Exclude).Select(kv => kv.Key).ToList();
        _items = await InventorySvc.QueryAsync(new ItemQuery(
            _search, include, exclude, Sort: _sort,
            IncludeTagIds: includeTags, ExcludeTagIds: excludeTags));
        _selectedIds.IntersectWith(_items.Select(x => x.Id));
        StateHasChanged();
    }

    private async Task CycleKindAsync(int kindId)
    {
        _kindFilter[kindId] = _kindFilter.GetValueOrDefault(kindId) switch
        {
            FilterMode.Off => FilterMode.Include,
            FilterMode.Include => FilterMode.Exclude,
            _ => FilterMode.Off
        };
        await ReloadAsync();
    }

    private async Task ClearKindFiltersAsync()
    {
        foreach (var id in _kindFilter.Keys.ToList()) _kindFilter[id] = FilterMode.Off;
        await ReloadAsync();
    }

    private static Color ChipColor(FilterMode mode) => mode switch
    {
        FilterMode.Include => Color.Primary,
        FilterMode.Exclude => Color.Error,
        _ => Color.Default
    };

    private async Task Adjust(Item item, decimal delta)
    {
        if (delta < 0)
            await Consumption.UseItemAsync(item.Id, -delta);
        else
            await InventorySvc.AdjustQuantityAsync(item.Id, delta);
        // Reload so the table re-renders: mutating a bound item's property alone does not
        // make MudTable refresh the row.
        await ReloadAsync();
    }

    private void OnRowClick(TableRowClickEventArgs<Item> args)
    {
        if (args.Item is not { } item) return;
        if (args.MouseEventArgs.Detail >= 2)
        {
            EndDrag();
            Nav.NavigateTo($"items/{item.Id}");
            return;
        }

        if (_dragSelecting)
        {
            ApplyDrag(item.Id);
            EndDrag();
            return;
        }

        if (args.MouseEventArgs.CtrlKey || args.MouseEventArgs.MetaKey)
            SetSelected(item.Id, !_selectedIds.Contains(item.Id));
        else
        {
            _selectedIds.Clear();
            _selectedIds.Add(item.Id);
        }
    }

    private async Task CycleTagAsync(int tagId)
    {
        _tagFilter[tagId] = _tagFilter.GetValueOrDefault(tagId) switch
        {
            FilterMode.Off => FilterMode.Include,
            FilterMode.Include => FilterMode.Exclude,
            _ => FilterMode.Off
        };
        await ReloadAsync();
    }

    private async Task ClearTagFiltersAsync()
    {
        foreach (var id in _tagFilter.Keys.ToList()) _tagFilter[id] = FilterMode.Off;
        await ReloadAsync();
    }

    private async Task SetSortAsync(ItemSort sort)
    {
        _sort = sort;
        await ReloadAsync();
    }

    private void OnRowMouseLeave(TableRowHoverEventArgs<Item> args) => ContinueDrag(args);

    private void OnRowMouseEnter(TableRowHoverEventArgs<Item> args)
    {
        if ((args.PointerEventArgs.Buttons & 1) == 0)
        {
            EndDrag();
            return;
        }
        ContinueDrag(args);
    }

    private void ContinueDrag(TableRowHoverEventArgs<Item> args)
    {
        if (args.Item is not { } item || (args.PointerEventArgs.Buttons & 1) == 0) return;
        if (!_dragSelecting)
        {
            _dragSelecting = true;
            _dragVisited.Clear();
            _dragSelectValue = !_selectedIds.Contains(item.Id);
            if (!args.PointerEventArgs.CtrlKey && !args.PointerEventArgs.MetaKey)
            {
                _selectedIds.Clear();
                _dragSelectValue = true;
            }
        }
        ApplyDrag(item.Id);
    }

    private void ApplyDrag(int itemId)
    {
        if (!_dragVisited.Add(itemId)) return;
        SetSelected(itemId, _dragSelectValue);
    }

    private void EndDrag()
    {
        _dragSelecting = false;
        _dragVisited.Clear();
    }

    private void SetSelected(int itemId, bool selected)
    {
        if (selected) _selectedIds.Add(itemId);
        else _selectedIds.Remove(itemId);
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        EndDrag();
        CloseContextMenu();
    }

    private void OpenContextMenu(MouseEventArgs args, Item item)
    {
        EndDrag();
        if (!_selectedIds.Contains(item.Id))
        {
            _selectedIds.Clear();
            _selectedIds.Add(item.Id);
        }
        _contextMenuX = args.ClientX;
        _contextMenuY = args.ClientY;
        _contextMenuOpen = true;
    }

    private void CloseContextMenu() => _contextMenuOpen = false;

    private async Task OpenQuickMoveAsync()
    {
        CloseContextMenu();
        if (_selectedIds.Count == 0) return;
        var selected = _selectedIds.ToList();
        var parameters = new DialogParameters
        {
            ["Locations"] = _locations,
            ["ThingLabel"] = $"{selected.Count} selected item{(selected.Count == 1 ? string.Empty : "s")}"
        };
        var dialog = await Dialogs.ShowAsync<MoveToDialog>("Quick Move", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MoveToDialog.Destination destination }) return;

        var previous = await InventorySvc.MoveItemsAsync(selected, destination.LocationId, destination.ContainerId);
        var label = destination.ContainerId is { } containerId
            ? ContainerLabel(containerId)
            : $"loose in {LocationName(destination.LocationId)}";
        ClearSelection();
        await ReloadAsync();
        Snackbar.Add($"Moved {selected.Count} item{(selected.Count == 1 ? string.Empty : "s")} to {label}.",
            Severity.Success, options =>
            {
                options.Action = "Undo";
                options.VisibleStateDuration = 8000;
                options.OnClick = async _ =>
                {
                    await InventorySvc.RestorePlacementsAsync(previous);
                    await ReloadAsync();
                    await InvokeAsync(StateHasChanged);
                };
            });
    }

    private string LocationName(int locationId) =>
        _locations.FirstOrDefault(x => x.Id == locationId)?.Name ?? "location";

    private string ContainerLabel(int containerId)
    {
        var location = _locations.FirstOrDefault(x => x.Containers.Any(c => c.Id == containerId));
        var container = location?.Containers.FirstOrDefault(c => c.Id == containerId);
        return location is null || container is null ? "container" : $"{location.Name} › {container.Name}";
    }

    private string RowClass(Item item, int _) =>
        _selectedIds.Contains(item.Id) ? "inventory-row-selected" : string.Empty;

    // Row dragging owns the pointer gesture in list view. Inline style is deliberate here:
    // MudTable renders the <tr> inside a child component, where isolated CSS alone is not
    // reliable across browsers (especially WebKit's prefixed selection behavior).
    private static string RowStyle(Item _, int __) =>
        "user-select:none;-webkit-user-select:none;cursor:default";

    private static string LocationLabel(Item i) =>
        i.Container is not null ? $"{i.Container.Location?.Name} › {i.Container.Name}"
        : i.Location?.Name ?? "—";
}
